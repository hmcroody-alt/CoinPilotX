{
  "name": "pulsesoc-native",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "start:qa": "expo start --dev-client",
    "web:qa": "expo start --web --port 8094",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "android:emulator": "expo run:android",
    "ios:simulator": "expo run:ios --device",
    "prebuild:android": "expo prebuild --platform android",
    "prebuild:ios": "expo prebuild --platform ios",
    "build:android:development": "npx eas-cli build --platform android --profile development",
    "build:ios:development": "npx eas-cli build --platform ios --profile development",
    "build:ios:simulator": "npx eas-cli build --platform ios --profile development-simulator",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:realtime-audio-architecture": "jest src/core/__tests__/realtimeAudioArchitecture.test.ts",
    "test:realtime-audio-critical": "jest --runTestsByPath src/core/__tests__/realtimeAudioArchitecture.test.ts src/core/__tests__/realtimeAudioContracts.test.ts src/core/__tests__/realtimeAudioInvariants.test.ts src/core/__tests__/realtimeAudioEngine.test.ts src/core/__tests__/audioOwnershipPolicy.test.ts src/calls/__tests__/callAudioOwnershipRegression.test.ts src/calls/__tests__/useNativeCallRoomAudio.test.ts src/live/__tests__/liveAudioPublisher.test.ts src/live/__tests__/cohostPublishGate.test.ts src/live/__tests__/remoteAudioReapply.test.ts",
    "test:realtime-audio": "jest src/core/__tests__/realtimeAudio src/core/__tests__/audioOwnershipPolicy src/calls/__tests__/callAudioOwnershipRegression src/calls/__tests__/useNativeCallRoomAudio src/live/__tests__/liveAudio src/live/__tests__/cohostPublishGate src/live/__tests__/remoteAudioReapply src/live/__tests__/liveSession",
    "i18n:validate": "node scripts/validate-i18n.mjs",
    "i18n:hardcoded": "node scripts/find-hardcoded-strings.mjs",
    "verify": "npm run typecheck && npm run i18n:validate && npm test",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@babel/runtime": "^7.29.7",
    "@egjs/hammerjs": "2.0.17",
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.0.3",
    "@livekit/react-native": "^2.9.0",
    "@livekit/react-native-webrtc": "144.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^6.6.1",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "^6.11.0",
    "babel-preset-expo": "~54.0.10",
    "expo": "~54.0.36",
    "expo-asset": "~12.0.13",
    "expo-av": "~16.0.8",
    "expo-battery": "~10.0.8",
    "expo-camera": "~17.0.10",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "~6.0.21",
    "expo-device": "~8.0.10",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.23",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-local-authentication": "~17.0.8",
    "expo-notifications": "~0.32.17",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "livekit-client": "^2.15.4",
    "nullthrows": "1.1.1",
    "pulse-now-playing": "file:./modules/pulse-now-playing",
    "react": "19.1.0",
    "react-dom": "^19.1.0",
    "react-native": "^0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^12.9.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.10",
    "jest": "~29.7.0",
    "jest-expo": "~54.0.17",
    "patch-package": "^8.0.1",
    "react-test-renderer": "19.1.0",
    "typescript": "~5.9.2"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ]
  },
  "expo": {
    "doctor": {
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false
      }
    }
  }
}
