+#pragma mark - PulseSoc Engine Diagnostics
+
+// The three booleans above (isPlaying / isRecording / isEngineRunning) are not
+// sufficient to diagnose a Live broadcast that reports recording=true while
+// engine=false: they collapse the ADM's separate ENABLED and RUNNING state into
+// one bit each. RTCAudioEngineState carries both, plus the init-level flags, so
+// JS can tell "input enabled but not running" (engine never started) apart from
+// "input neither enabled nor running" (engine torn down). Read-only snapshot -
+// this method must never mutate ADM state.
+RCT_EXPORT_BLOCKING_SYNCHRONOUS_METHOD(audioDeviceModuleGetEngineState) {
+    RTCAudioDeviceModule *adm = self.audioDeviceModule;
+    if (adm == nil) {
+        return nil;
+    }
+    RTCAudioEngineState state = adm.engineState;
+    RTCAudioEngineAvailability availability = adm.engineAvailability;
+    return @{
+        @"outputEnabled" : @(state.outputEnabled),
+        @"outputRunning" : @(state.outputRunning),
+        @"inputEnabled" : @(state.inputEnabled),
+        @"inputRunning" : @(state.inputRunning),
+        @"inputMuted" : @(state.inputMuted),
+        @"muteMode" : @((NSInteger)state.muteMode),
+        @"playoutInitialized" : @(adm.isPlayoutInitialized),
+        @"recordingInitialized" : @(adm.isRecordingInitialized),
+        @"playing" : @(adm.isPlaying),
+        @"recording" : @(adm.isRecording),
+        @"engineRunning" : @(adm.isEngineRunning),
+        @"microphoneMuted" : @(adm.isMicrophoneMuted),
+        @"recordingAlwaysPrepared" : @(adm.isRecordingAlwaysPreparedMode),
+        @"manualRendering" : @(adm.isManualRenderingMode),
+        @"inputAvailable" : @(availability.isInputAvailable),
+        @"outputAvailable" : @(availability.isOutputAvailable)
+    };
+}
+
+// filters: substrings a WebRTC log line must contain to be retained. Passing an
+// empty array captures nothing rather than everything - a capture with no filter
+// would retain unrelated log traffic, which this deliberately refuses to do.
+RCT_EXPORT_BLOCKING_SYNCHRONOUS_METHOD(audioDeviceModuleStartEngineLogCapture
+                                       : (NSArray<NSString *> *)filters capacity
+                                       : (NSNumber *)capacity) {
+    os_unfair_lock_lock(&pulseSocEngineLogLock);
+    pulseSocEngineLogFilters = [filters copy] ?: @[];
+    NSInteger requested = capacity.integerValue;
+    pulseSocEngineLogCapacity = (NSUInteger)MAX((NSInteger)16, MIN((NSInteger)1000, requested));
+    pulseSocEngineLogEntries = [NSMutableArray arrayWithCapacity:pulseSocEngineLogCapacity];
+    pulseSocEngineLogDropped = 0;
+    BOOL alreadyRunning = pulseSocEngineLogger != nil;
+    os_unfair_lock_unlock(&pulseSocEngineLogLock);
+
+    // Re-entrant start would stack a second logger onto the same stream and
+    // duplicate every captured line, so an existing capture keeps its logger and
+    // only swaps the filter set above.
+    if (alreadyRunning) {
+        return @(YES);
+    }
+
+    RTCCallbackLogger *logger = [[RTCCallbackLogger alloc] init];
+    logger.severity = RTCLoggingSeverityInfo;
+    [logger startWithMessageAndSeverityHandler:^(NSString *message, RTCLoggingSeverity severity) {
+        if (message.length == 0) {
+            return;
+        }
+        os_unfair_lock_lock(&pulseSocEngineLogLock);
+        NSArray<NSString *> *activeFilters = pulseSocEngineLogFilters;
+        BOOL keep = NO;
+        for (NSString *needle in activeFilters) {
+            if (needle.length > 0 && [message rangeOfString:needle].location != NSNotFound) {
+                keep = YES;
+                break;
+            }
+        }
+        if (keep && pulseSocEngineLogEntries != nil) {
+            if (pulseSocEngineLogEntries.count >= pulseSocEngineLogCapacity) {
+                [pulseSocEngineLogEntries removeObjectAtIndex:0];
+                pulseSocEngineLogDropped += 1;
+            }
+            NSString *trimmed = message.length > 400 ? [message substringToIndex:400] : message;
+            [pulseSocEngineLogEntries addObject:@{
+                @"severity" : @((NSInteger)severity),
+                @"message" : [trimmed stringByTrimmingCharactersInSet:[NSCharacterSet whitespaceAndNewlineCharacterSet]]
+            }];
+        }
+        os_unfair_lock_unlock(&pulseSocEngineLogLock);
+    }];
+
+    os_unfair_lock_lock(&pulseSocEngineLogLock);
+    pulseSocEngineLogger = logger;
+    os_unfair_lock_unlock(&pulseSocEngineLogLock);
+    return @(YES);
+}
+
+// Returns captured lines and clears the buffer, so a caller that drains after
+// every guard pass cannot re-report the same native error twice.
+RCT_EXPORT_BLOCKING_SYNCHRONOUS_METHOD(audioDeviceModuleDrainEngineLogCapture) {
+    os_unfair_lock_lock(&pulseSocEngineLogLock);
+    NSArray<NSDictionary *> *entries = [pulseSocEngineLogEntries copy] ?: @[];
+    NSUInteger dropped = pulseSocEngineLogDropped;
+    [pulseSocEngineLogEntries removeAllObjects];
+    pulseSocEngineLogDropped = 0;
+    os_unfair_lock_unlock(&pulseSocEngineLogLock);
+    return @{@"entries" : entries, @"dropped" : @(dropped)};
+}
+
+RCT_EXPORT_BLOCKING_SYNCHRONOUS_METHOD(audioDeviceModuleStopEngineLogCapture) {
+    os_unfair_lock_lock(&pulseSocEngineLogLock);
+    RTCCallbackLogger *logger = pulseSocEngineLogger;
+    pulseSocEngineLogger = nil;
+    [pulseSocEngineLogEntries removeAllObjects];
+    pulseSocEngineLogDropped = 0;
+    os_unfair_lock_unlock(&pulseSocEngineLogLock);
+    [logger stop];
+    return @(logger != nil);
+}
