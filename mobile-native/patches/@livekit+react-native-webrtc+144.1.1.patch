+// PulseSoc diagnostics: bounded ring buffer for WebRTC's own audio-engine log
+// lines. WebRTC already logs the exact reason an AVAudioEngine start fails
+// ("Failed to start engine: <err>", "No input path.", "ReconfigureEngine:
+// Failed to recover engine state, error: ...") but those lines never reach
+// JS, so a Live broadcast failure surfaces as an unexplained engine=false.
+// This capture forwards ONLY lines matching caller-supplied substrings, so
+// the filter policy lives in JS and no unrelated log traffic is retained.
+// A category cannot add ivars, hence file-static storage.
+static RTCCallbackLogger *pulseSocEngineLogger = nil;
+static NSMutableArray<NSDictionary *> *pulseSocEngineLogEntries = nil;
+static NSArray<NSString *> *pulseSocEngineLogFilters = nil;
+static NSUInteger pulseSocEngineLogCapacity = 200;
+static NSUInteger pulseSocEngineLogDropped = 0;
+// os_unfair_lock, not NSLock: this callback fires on WebRTC's own threads
+// including the audio thread, and os_unfair_lock donates priority so a
+// logging burst cannot invert priority against the render thread.
+static os_unfair_lock pulseSocEngineLogLock = OS_UNFAIR_LOCK_INIT;
+
 @implementation WebRTCModule (RTCAudioDeviceModule)
 
 #pragma mark - Recording & Playback Control
 
+// PulseSoc addition. `startPlayout` sets outputRunning but never outputEnabled,
+// and ModifyEngineState refuses that pair ("Output must be enabled if running").
+// `initPlayout` is the only call that enables the output path, and the stock
+// package does not bridge it, so a participant that subscribes to no remote
+// audio can never bring output up from JS. AVAudioEngine will not run without an
+// enabled output, and with the engine down the INPUT does not deliver buffers
+// either - which is why a Live host published a silent track while the ADM
+// happily reported inputEnabled/inputRunning true.
+//
+// Synchronous so the caller can order it before `startPlayout` without a race,
+// and it returns the raw ADM status instead of rejecting so a diagnostic can
+// never break the broadcast it is describing.
+RCT_EXPORT_BLOCKING_SYNCHRONOUS_METHOD(audioDeviceModuleInitPlayout) {
+    return @([self.audioDeviceModule initPlayout]);
+}
