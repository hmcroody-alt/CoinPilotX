{
  "expo": {
    "name": "PulseSoc",
    "slug": "pulsesoc-native",
    "scheme": "pulsesoc",
    "version": "1.0.1",
    "newArchEnabled": false,
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "ios": {
      "bundleIdentifier": "com.pulsesoc.app",
      "buildNumber": "19",
      "supportsTablet": false,
      "entitlements": {
        "com.apple.developer.in-app-payments": [
          "merchant.com.pulsesoc.app"
        ]
      },
      "associatedDomains": [
        "applinks:pulsesoc.com"
      ],
      "infoPlist": {
        "NSCameraUsageDescription": "PulseSoc uses the camera for native status, reels, profile media, and calls.",
        "NSMicrophoneUsageDescription": "PulseSoc uses the microphone for native voice/video calls and media capture.",
        "NSPhotoLibraryUsageDescription": "PulseSoc uses the photo library for profile, chat, status, and reels uploads.",
        "NSPhotoLibraryAddUsageDescription": "PulseSoc saves photos and videos you download to your photo library.",
        "NSFaceIDUsageDescription": "PulseSoc uses Face ID to unlock your saved sign-in securely.",
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "audio",
          "fetch",
          "remote-notification"
        ]
      }
    },
    "android": {
      "package": "com.pulsesoc.nativeapp",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "pulsesoc.com",
              "pathPrefix": "/pulse"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "READ_MEDIA_IMAGES",
        "READ_MEDIA_VIDEO",
        "POST_NOTIFICATIONS",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT"
      ]
    },
    "plugins": [
      "./plugins/withLegacyIosFmtCompatibility",
      "./plugins/withDevelopmentIosIdentity",
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.pulsesoc.app"
        }
      ],
      "expo-font",
      "expo-secure-store",
      "expo-notifications",
      "expo-camera",
      "expo-image-picker",
      "expo-local-authentication",
      [
        "expo-media-library",
        {
          "photosPermission": "PulseSoc uses the photo library for profile, chat, status, and reels uploads.",
          "savePhotosPermission": "PulseSoc saves photos and videos you download to your photo library.",
          "isAccessMediaLocationEnabled": false
        }
      ]
    ],
    "extra": {
      "pulseApiBaseUrl": "https://pulsesoc.com",
      "track": "parallel-native-foundation",
      "expoProjectId": "",
      "eas": {
        "projectId": "03be39d7-db88-43af-af5f-50c267d830f8"
      }
    },
    "owner": "hmcroody"
  }
}
