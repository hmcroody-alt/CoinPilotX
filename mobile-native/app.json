{
  "expo": {
    "name": "PulseSoc",
    "slug": "pulsesoc-native",
    "scheme": "pulsesoc",
    "version": "1.0",
    "newArchEnabled": false,
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "ios": {
      "bundleIdentifier": "com.pulsesoc.app",
      "buildNumber": "1",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "PulseSoc uses the camera for native status, reels, profile media, and calls.",
        "NSMicrophoneUsageDescription": "PulseSoc uses the microphone for native voice/video calls and media capture.",
        "NSPhotoLibraryUsageDescription": "PulseSoc uses the photo library for profile, chat, status, and reels uploads.",
        "NSFaceIDUsageDescription": "PulseSoc uses Face ID to unlock your saved sign-in securely.",
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "package": "com.pulsesoc.nativeapp",
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "READ_MEDIA_IMAGES",
        "READ_MEDIA_VIDEO",
        "POST_NOTIFICATIONS",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT"
      ]
    },
    "plugins": [
      "./plugins/withLegacyIosFmtCompatibility",
      "./plugins/withDevelopmentIosIdentity",
      "expo-font",
      "expo-secure-store",
      "expo-notifications",
      "expo-camera",
      "expo-image-picker",
      "expo-local-authentication"
    ],
    "extra": {
      "pulseApiBaseUrl": "https://pulsesoc.com",
      "track": "parallel-native-foundation",
      "expoProjectId": "",
      "eas": {
        "projectId": "03be39d7-db88-43af-af5f-50c267d830f8"
      }
    },
    "owner": "hmcroody"
  }
}
