{
  "name": "pulsesoc-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "PulseSoc web client. Built in CI, served by Flask as hashed static assets -- there is no Node in the production image.",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build && node scripts/fingerprint.mjs --write",
    "fingerprint": "node scripts/fingerprint.mjs --write",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "~5.9.0",
    "vite": "^6.0.0"
  }
}
