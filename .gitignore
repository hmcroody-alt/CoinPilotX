.env
.env.*
!.env.example

*.log
undx_execution_log.jsonl
.undx_backups/
.undx/
.undx_connector_audit_workspace/
.undx_brain_layer_audit_workspace/
coinpilotx.db
# sqlite side files: the WAL and shm are runtime state, not source. A committed
# -wal shows up modified after every request and its diff is unreviewable binary.
coinpilotx.db-wal
coinpilotx.db-shm
*.sqlite
*.sqlite3
# Database dumps from scripts/ops/backup_database.py. These are a byte-for-byte
# copy of production: every user row, every message, every token. Committing one
# publishes the database to anyone with repository access and, because git keeps
# history, a later `git rm` does not take it back.
backups/
*.sql.gz
# Rotated logs. `*.log` above does not match `coinpilotx.log.1`.
*.log.[0-9]
# FUSE leaves one of these behind for every file deleted while still open. They
# are placeholders for data already gone, never source.
.fuse_hidden*
storage/messenger_uploads/

# Runtime user-media upload target — must not be committed (privacy)
static/uploads/
# Large screen recordings / captures
reports/screenshots/*ScreenRecording*
*.mov

__pycache__/
*.py[cod]
.Python

node_modules/
.expo/
mobile/pulse-react-native/builds/

.DS_Store
*/.DS_Store

venv/
.venv/
outputs/.mutate*-original

# Claude Code runtime lock, owned by a live session (not shared state)
.claude/scheduled_tasks.lock

# Claude Code agent worktrees live here; they are live checkouts, not shared source
.claude/worktrees/
