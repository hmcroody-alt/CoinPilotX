# PulseSoc server-side translation (Google Cloud Translation Advanced)
# Railway go-live checklist:
#   1. TRANSLATION_ENABLED=true
#   2. TRANSLATION_QA_ONLY=false (or add your user id to TRANSLATION_QA_USER_IDS)
#   3. GOOGLE_CLOUD_PROJECT_ID + one of GOOGLE_CLOUD_TRANSLATION_CREDENTIALS_JSON
#      (full service-account JSON, escaped \n in private_key is tolerated) or
#      GOOGLE_CLOUD_TRANSLATION_API_KEY
#   4. Verify: GET /internal/health/translation?probe=1 → healthy:true
TRANSLATION_ENABLED=false
TRANSLATION_QA_ONLY=true
TRANSLATION_QA_USER_IDS=
TRANSLATION_PRIMARY_PROVIDER=google
TRANSLATION_AUTO_DETECT_ENABLED=true
TRANSLATION_CACHE_ENABLED=true
TRANSLATION_CACHE_TTL_SECONDS=86400
TRANSLATION_PRESERVE_ORIGINAL=true
TRANSLATION_SHOW_ORIGINAL_OPTION=true
TRANSLATION_USER_OVERRIDE_ENABLED=true
TRANSLATION_GLOSSARY_ENABLED=false
TRANSLATION_REQUEST_TIMEOUT_SECONDS=10
TRANSLATION_MAX_RETRIES=2
TRANSLATION_FAIL_OPEN=true
TRANSLATION_MODERATION_BEFORE_TRANSLATION=true
TRANSLATION_MODERATION_AFTER_TRANSLATION=true
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_CLOUD_TRANSLATION_LOCATION=global
GOOGLE_CLOUD_TRANSLATION_CREDENTIALS_JSON=
GOOGLE_CLOUD_TRANSLATION_API_KEY=

# --- Analytics instrumentation ---------------------------------------------
# Request-level visitor logging (populates visitor_logs, which backs the
# "Visitors - 24h" KPI, the Live Visitors page, and Visitor Intelligence).
# DEFAULTS TO OFF. While it is off those surfaces report a truthful-looking 0
# that actually means "not instrumented". Set to true to measure visitors.
# Cost: one SELECT + INSERT + COMMIT per non-/api/ page request, deduplicated
# per session+path per minute.
PULSESOC_VISITOR_LOGGING_ENABLED=false

# ============================================================================
# VARIABLES READ BY PRODUCTION CODE BUT PREVIOUSLY UNDOCUMENTED
# ============================================================================
# Added during the backend operations recovery audit (Aug 2026).
#
# Every key below is read by bot.py, services/, a worker, or
# pulse_communications_v2/ at runtime. None of them appeared in this file, so
# an operator provisioning a fresh environment from .env.example got a boot
# with media storage, live streaming, Telegram, Twilio and Redis silently
# unconfigured. Because optional route packs register inside `except`
# blocks, the resulting failure mode is a surface that 404s or returns empty
# rather than a startup error - which is exactly the class of problem this
# audit exists to remove.
#
# Values shown are the defaults the code itself falls back to. A blank value
# means the code has no default and the feature is off until it is set.
# Secrets are intentionally left blank - fill them from the provider console.
#
# Where two names appear for one setting, both are accepted; the first is
# preferred (e.g. R2_BUCKET is checked before S3_BUCKET).

# --- Cloudflare R2 / object storage (media, uploads, replays) ------------------
AWS_ACCESS_KEY_ID=
AWS_REGION=auto
AWS_SECRET_ACCESS_KEY=
R2_ACCESS_KEY_ID=
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ENDPOINT=
R2_ENDPOINT_URL=
R2_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_ENDPOINT_URL=

