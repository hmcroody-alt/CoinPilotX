# PulseSoc / CoinPlotXAI Inc. environment template
# Copy to .env for local development only. Never commit real credentials.

# Core app
DATABASE_URL=
# REQUIRED in any deployed environment. This is the ROOT secret: five
# per-purpose signing keys are derived from it (Flask session, mobile bearer,
# messenger media URLs, password reset, captcha). Boot fails without it, on
# purpose: each gunicorn worker would otherwise invent its own root, derive a
# different key for every purpose, and reject tokens minted by the other worker.
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
#
# Only the FIRST of these three that is set is used, in the order listed.
# Setting more than one is not an error and not a fallback -- the rest are
# ignored. Deleting the one in use silently promotes the next, which rotates
# every key at once, including the session key. See the warning below.
FLASK_SECRET_KEY=
SECRET_KEY=
SESSION_SECRET=
# Set to 1 to accept a per-process random secret in a deployed environment.
# This re-enables intermittent cross-worker auth failure; only for debugging.
PULSESOC_ALLOW_EPHEMERAL_SECRET=

# Per-purpose signing key overrides. Leave ALL of these blank in normal
# operation: each key is derived from the root above, so the split needs no
# configuration and there is no way to deploy a half-applied version of it.
#
# Setting one replaces that single derived key, which is how you rotate one
# credential family without touching the other four. Read the rotation costs in
# services/signing_keys.py first -- they are not comparable:
#
#   MOBILE_ACCESS / MESSENGER_MEDIA  ~15 min, clients self-heal, no user action
#   CAPTCHA                          one retry for whoever is mid-form
#   PASSWORD_RESET                   pending links (<=1h) must be re-requested
#   SESSION                          EVERY web user logged out, permanently.
#                                    There is no recovery but re-login: the
#                                    cookie is client-side signed, has no
#                                    server-side row, and lives 10 years.
#
# Rotating the ROOT rotates all five at once, including SESSION. Rotating only
# PULSESOC_MOBILE_ACCESS_SECRET is the cheap, self-healing operation, and is
# what you almost always want after a suspected bearer-token leak.
PULSESOC_SESSION_SECRET=
PULSESOC_MOBILE_ACCESS_SECRET=
PULSESOC_MESSENGER_MEDIA_SECRET=
PULSESOC_PASSWORD_RESET_SECRET=
PULSESOC_CAPTCHA_SECRET=
SESSION_COOKIE_SECURE=1
# Mirror all INFO+ log records to stdout. Defaults to on, and should stay on in
# any container platform: Railway captures only stdout/stderr, so setting this
# to 0/false/no makes the entire backend log silent in production rather than
# merely quieter. Only useful locally, where the file handler is readable.
LOG_TO_STDOUT=1

# Telegram
BOT_TOKEN=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Additional webhook signing secrets, separated by whitespace, commas or
# semicolons. Every configured secret is tried against the signature, so one
# deployment verifies several Stripe destinations at once (the platform
# endpoint and, once Connect is enabled, the Connect-scoped one) and a secret
# can be rolled without a window where neither the old nor the new verifies.
# A destination whose secret is not in this set fails closed with
# SIGNATURE_INVALID -- which is how the previous live endpoint died after nine
# days of 100%-failing deliveries. See services/stripe_webhook_verification.py.
STRIPE_WEBHOOK_SECRETS=
STRIPE_PRICE_ID=
APP_BASE_URL=https://coinpilotx.app
# Direct/public Stripe links are intentionally not used for Pro checkout.
STRIPE_PRO_LINK=

# Media / video delivery
MEDIA_STORAGE_PROVIDER=r2
R2_PUBLIC_BASE_URL=https://cdn.coinpilotx.app
# Public, no-challenge source URL used only for Mux asset downloads.
# Example: https://pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev
MUX_SOURCE_BASE_URL=
R2_MUX_SOURCE_BASE_URL=

# BTC payments
BTC_PAYMENT_ADDRESS=

# Admin
ADMIN_ANALYTICS_PASSWORD=
ADMIN_DASHBOARD_TOKEN=
ADMIN_BOOTSTRAP_TOKEN=
ADMIN_RESET_OWNER_PASSWORD=
# Admin session lifetimes (defaults: 12h absolute, 60min idle)
ADMIN_SESSION_ABSOLUTE_HOURS=12
ADMIN_SESSION_IDLE_MINUTES=60

# SEO, indexing, and analytics
GA_MEASUREMENT_ID=
POSTHOG_KEY=
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Transactional email
# Railway should provide BREVO_API_KEY as a private environment variable.
EMAIL_PROVIDER=brevo
BREVO_API_KEY=
BREVO_DEFAULT_LIST_ID=
BREVO_PRO_LIST_ID=
BREVO_TELEGRAM_LIST_ID=
DEFAULT_FROM_EMAIL=support@pulsesoc.com
BREVO_SENDER_EMAIL=support@pulsesoc.com
BREVO_REPLY_TO=support@pulsesoc.com
BREVO_SENDER_NAME=PulseSoc
BREVO_EMAIL_ENABLED=true
MAIL_FROM_ADDRESS=support@pulsesoc.com
MAIL_FROM_NAME=PulseSoc
SUPPORT_EMAIL=support@pulsesoc.com
PUBLIC_SUPPORT_EMAIL=support@pulsesoc.com
COMPANY_NAME=CoinPlotXAI Inc.
PRODUCT_NAME=PulseSoc
SUPPORT_FROM_ADDRESS=support@pulsesoc.com
SUPPORT_FROM_NAME=PulseSoc Support
SECURITY_EMAIL=support@pulsesoc.com
SECURITY_FROM_ADDRESS=support@pulsesoc.com
SECURITY_FROM_NAME=PulseSoc Security

# Optional email fallbacks
SENDGRID_API_KEY=
MAILGUN_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=

# AI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
CLAUDE_AI_API=
Gemini_AI_API=
DEEPSEEK_AI_API=
GROQ_AI_API=
# Meta Model API ("Muse"). NOT MODEL_API_KEY - the router reads this name, and a
# router reading the other one finds nothing, reports Meta unconfigured and skips
# it forever without an error anywhere.
META_MODEL_API_KEY=
# LEAVE EMPTY. Documented here because it must stay unset, not because it should
# be set: this deployment currently carries six ANTHROPIC_* variables that point
# at api.meta.ai with ANTHROPIC_MODEL=muse-spark-1.3-contributor — Meta's
# training tier — under the names every library, snippet and new contributor
# reaches for when they want Anthropic. The router ignores them and reads
# CLAUDE_AI_API and META_MODEL_API_KEY above, so nothing is broken today; what
# is wrong is that anything else in this codebase that follows the convention
# gets a training tier while the privacy matrix believes Anthropic is in use.
# services/undx_config_drift.py reports a non-empty value here as CRITICAL.
ANTHROPIC_MODEL=
# Unset means muse-spark-1.3, the Standard tier. The Contributor variant
# (muse-spark-1.3-contributor) is ~95% cheaper because Meta's own console states
# its inputs and outputs are used to train Meta's models, and it is rate-limited
# to 100 RPM against Standard's 3,000. Set this only for traffic known to carry
# no user or customer data. See docs/UNDX_PROVIDER_DATA_POLICY.md.
META_MUSE_MODEL=
# One of: none, minimal, low, medium, high, xhigh, max. Unset means high.
# This is a cost control as much as a quality one: measured live, ~95% of Meta's
# billed output tokens on a trivial question were reasoning nobody reads.
META_MUSE_REASONING_EFFORT=
# Kill switch. Set false to drop Meta from rotation without deleting the credential.
META_MUSE_ENABLED=true
# Load-bearing. Meta's first call on a cold route measured 26.7s against the
# router's 25s module default, so the default below must not be lowered casually.
META_MUSE_TIMEOUT_MS=60000

# Perplexity. Used by the router as the grounded-research lane (it answers from a
# live web search and returns its sources), and by services/undx_embedding_service.py
# for UNDX semantic retrieval. Leaving the key unset is a supported production
# state: retrieval falls back to the existing lexical path and UNDX keeps working.
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar
PERPLEXITY_TIMEOUT_MS=45000

# Per-provider kill switches. Absent means enabled; these change nothing until
# one is set to a false value.
UNDX_OPENAI_ENABLED=true
UNDX_CLAUDE_ENABLED=true
UNDX_PERPLEXITY_ENABLED=true

UNDX_ROUTER_ENABLED=false
UNDX_MULTI_MODEL_MODE=false
UNDX_DEFAULT_AI_PROVIDER=openai

# What a request is assumed to carry when its caller does not classify it.
# Unset means CONFIDENTIAL, which admits OpenAI, Claude and Meta's Standard tier
# and refuses Perplexity, Gemini, DeepSeek and Groq. Raising it (HIGHLY_SENSITIVE,
# RESTRICTED) narrows routing further; lowering it is ignored on purpose, so this
# variable cannot be used to switch the privacy ceiling off.
# See docs/UNDX_PROVIDER_DATA_POLICY.md.
UNDX_DEFAULT_REQUEST_PRIVACY=CONFIDENTIAL

# --- UNDX spend limits -------------------------------------------------------
# All unset by default: nothing is refused for cost until one of these is given
# a positive value. Spend is recorded either way, so a limit set mid-month
# starts from what the month has actually cost rather than from zero.
#
# Read this before setting a dollar figure. Only models with a vendor-verified
# price count toward it, and today that is Meta's two tiers and nothing else —
# so a dollar budget cannot see OpenAI, Claude, Gemini, DeepSeek or Groq spend
# at all. `undx_router.budget_state()["uncovered_providers"]` names exactly who
# is invisible in this deployment. UNDX_MONTHLY_TOKEN_BUDGET is the limit that
# covers everyone, because every adapter reports tokens.
UNDX_MONTHLY_COST_BUDGET_USD=
UNDX_MONTHLY_TOKEN_BUDGET=

# Per-provider, as `name=amount` pairs. Deliberately not JSON: a typo costs one
# provider its budget instead of parsing to nothing and switching every limit
# off at once. Example: UNDX_PROVIDER_COST_BUDGET_USD=meta=20,openai=5
UNDX_PROVIDER_COST_BUDGET_USD=
UNDX_PROVIDER_TOKEN_BUDGET=

# Refuse any provider whose model has no verified price while a dollar budget is
# set, on the grounds that unmeasurable spend cannot be capped. Off by default,
# because turning it on today removes five of seven providers. Set it only if a
# hard dollar ceiling matters more to you than availability.
UNDX_COST_BUDGET_STRICT=false

# The durable per-month, per-provider ledger in `undx_cost_ledger`. On by
# default: one upsert against a multi-second LLM call is noise, and the
# in-memory alternative gives nine worker processes nine separate tallies to
# check one limit against. Set false only to stop the writes entirely — the
# budget then enforces on this process's share, which under-counts.
UNDX_COST_LEDGER_ENABLED=true

# --- UNDX provider circuit breaker ---
#
# Provider health lives in `undx_provider_health`, shared by every worker. It
# used to be a dict in `undx_router`, which made "three consecutive failures"
# mean up to twenty-seven across four gunicorn workers plus five background
# workers, and gave each of the nine its own half-open recovery probe.
#
# Set false to go back to per-process state. The breaker itself keeps working;
# only the sharing stops. On by default because a breaker that opens too
# eagerly costs one provider for one cooldown and then heals itself — a much
# smaller and much more reversible harm than the same change would be to a rate
# limiter, which is why `SENTINEL_RATE_LIMIT` defaults the other way.
UNDX_PROVIDER_HEALTH_SHARED=true

# Consecutive failures before a provider is rested. Three tolerates the
# transient upstream 503s Gemini demonstrably produces while still catching a
# provider that is genuinely down. Raise this rather than switching sharing off
# if the now-deployment-wide count turns out to be too tight.
UNDX_BREAKER_THRESHOLD=3

# How long a rested provider stays out before one — exactly one, across the
# whole deployment — trial request is allowed through to test recovery.
UNDX_BREAKER_COOLDOWN_S=120

# The same, for failures no retry can fix: a revoked key (401/403), an unpaid
# invoice (402), a model ID the provider has retired (404 plus a body that says
# so). On the transient schedule above, those reprobe every two minutes forever,
# and each probe pays the provider's full timeout before failing the identical
# way — a permanent fault quietly converted into a permanent slow leak.
#
# Thirty minutes rather than "never", because the fix is a human action taken
# outside this process: a key rotated, an invoice paid, a model ID corrected. A
# breaker that could not notice those would need a restart to clear, which is a
# worse failure than the one it replaces. Values below UNDX_BREAKER_COOLDOWN_S
# are ignored — a dead key must never retry sooner than a transient timeout.
UNDX_BREAKER_ACTIONABLE_COOLDOWN_S=1800

# The kill switch for everything the omni-agentic work added: shadow traffic
# stops, and every canary user collapses to control. It does NOT stop UNDX —
# route_undx_request still routes, still fails over, still enforces the privacy
# ceiling and the budget. That separation is the point: an operator reaching for
# this during an incident wants the new, unproven behaviour gone, not the
# assistant gone, and a switch that takes the product down with the experiment is
# one nobody pulls in time. Read in exactly one place, undx_router.
UNDX_OMNI_ROUTER_ENABLED=false

# Shadow: ask a second provider the same question, compare, and discard what it
# said. The candidate's answer never reaches a user, a log, or the database —
# only ratios and statuses survive the call.
#
# Off by default, and off is also what an unparseable sample rate means: the
# failure mode of a typo here is a doubled bill on every request in production,
# so the unreadable case has to land on the cheap side.
UNDX_SHADOW_ENABLED=false
UNDX_SHADOW_PROVIDER=
UNDX_SHADOW_SAMPLE_RATE=0
UNDX_SHADOW_TIMEOUT_SECONDS=20
UNDX_SHADOW_LEDGER_ENABLED=true

# The highest privacy class that may be copied to a second vendor, which is a
# lower bar than the class that provider may receive normally — shadowing sends
# content to somebody the request did not choose.
#
# Note what PUBLIC means in practice: an unclassified request normalises to
# CONFIDENTIAL, so under this default the shadow observes nothing at all. That is
# deliberate. Enabling an experiment must not be the same act as authorising
# disclosure of private messages to an unchosen vendor; raising this is a
# separate, explicit decision.
#
# A name that is not a privacy class permits NOTHING rather than everything.
# UNDX_SHADOW_MAX_PRIVACY_CLASS=PUBIC once read as rank 6 and cleared every class
# below SECRET, because the shared "unknown" rank is the highest one — correct
# for classifying a request, inverted for a ceiling. `--shadow` prints whether
# the value you set is on the ladder.
UNDX_SHADOW_MAX_PRIVACY_CLASS=PUBLIC

# Internal canary: which PEOPLE reach the new routing, never which provider wins.
# An explicit list of user ids, not a percentage — the brief asks for an internal
# canary, and a random one percent of production is not internal, it is a
# hundredth of the customer base finding out about an experiment by being in it.
# A malformed entry is dropped with a warning; the rest of the list survives.
# Empty means the canary is inert, which `--canary` reports rather than hides.
UNDX_CANARY_ENABLED=false
UNDX_CANARY_USER_IDS=

# Self-hosted UNDX candidate (migration Stage 0+). Off by default; external providers unaffected.
# Only routable when ENABLED=true AND BASE_URL is set. Sorts last unless named in PULSE_AI_PROVIDER_ORDER.
UNDX_CANDIDATE_ENABLED=false
UNDX_CANDIDATE_BASE_URL=
UNDX_CANDIDATE_API_KEY=
UNDX_CANDIDATE_MODEL=undx-core-v1

# Market data
# Setting COINGECKO_API_KEY switches the client to the paid "pro" host and the
# x-cg-pro-api-key header; leaving it empty uses the public demo host and
# x-cg-demo-api-key. The demo host rejects paid keys (error 10010), so the host
# and header are always chosen together rather than configured separately.
COINGECKO_API_KEY=
# Override the API host explicitly. Leave empty to derive it from the key as
# described above; set it only to pin a host or point at a mock in testing.
COINGECKO_API_BASE=
# Per-request HTTP timeout in seconds. Default: 8
COINGECKO_TIMEOUT=
# Client-side request budget per minute, kept under the plan's ceiling.
# Default: 270
COINGECKO_RATE_LIMIT_PER_MIN=
# Oldest cached quote still served, in seconds, when CoinGecko is unreachable.
# Default: 1800
COINGECKO_STALE_MAX=
# TTL in seconds for the /simple/price cache. Default: 45
COINGECKO_SIMPLE_PRICE_TTL=
# Furthest back a history query may reach, in days. Default: 730
COINGECKO_HISTORY_MAX_DAYS=

# Market data - monthly credit budget guard
# The per-minute rate limit alone cannot protect a monthly credit allowance:
# the Basic plan permits 300 req/min but only 100,000 credits/month, which is a
# sustained 2.31 req/min. The guard tracks month-to-date spend and widens cache
# TTLs as the budget is consumed, so the plan degrades freshness instead of
# going dark mid-month. It fails open on an unknown spend figure.
# Set to 0/false/no to disable the guard entirely. Default: 1 (enabled)
COINGECKO_BUDGET_GUARD=
# Total credits the plan allows per month. Default: 100000
COINGECKO_MONTHLY_CREDIT=
# Month-end spend the guard steers toward, leaving headroom. Default: 80000
COINGECKO_BUDGET_TARGET=
# Credits consumed before the state becomes "warning". Default: 50000
COINGECKO_BUDGET_WARN=
# Credits consumed before the state becomes "high". Default: 75000
COINGECKO_BUDGET_HIGH=
# Credits consumed before the state becomes "protective". Default: 90000
COINGECKO_BUDGET_PROTECT=
# TTL multiplier applied in the "high" state. Default: 2
COINGECKO_HIGH_TTL_MULTIPLIER=
# TTL multiplier applied in the "protective" state. Default: 4
COINGECKO_PROTECTIVE_TTL_MULTIPLIER=
# How often, in seconds, the guard re-reads month-to-date spend while in the
# "normal" state. Default: 1800
COINGECKO_BUDGET_REFRESH=

COINMARKETCAP_API_KEY=
CMC_API_KEY=

# Sports data
THE_ODDS_API_KEY=
SPORTSDATA_API_KEY=

# Brevo SMS notifications
BREVO_SMS_API_KEY=
BREVO_SMS_ENABLED=false
BREVO_SMS_SENDER=PulseSoc
SMS_SENDER_NAME=PulseSoc
BREVO_SMS_REPLY_EMAIL=support@pulsesoc.com

# PulseSoc Notification Phase 2 delivery adapters
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:support@pulsesoc.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@pulsesoc.com
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
FCM_SERVER_KEY=
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_PRIVATE_KEY=
APNS_BUNDLE_ID=
APNS_USE_SANDBOX=false
# PushKit VoIP pushes go to a separate APNs topic: the bundle id with a ".voip"
# suffix. Leave blank to derive it from APNS_BUNDLE_ID. The same token-based .p8
# credential above signs both alert and VoIP pushes - no VoIP Services
# Certificate is required. Unset means iOS incoming calls fall back to the
# normal alert push, which cannot ring a locked or backgrounded phone.
APNS_VOIP_BUNDLE_ID=
# Extra app bundle ids this deployment may address, comma separated. Only needed
# once a second build flavour exists - a development bundle id alongside the store
# one. The VoIP sender derives "apns-topic" from the bundle each device reports,
# and a bundle that is not listed here falls back to the deployment-wide topic
# rather than being trusted. A device addressed on the wrong topic gets
# DeviceTokenNotForTopic, which revokes its token permanently and is not replayed,
# so add the id here before shipping any build that uses it.
APNS_ALLOWED_BUNDLE_IDS=
PULSESOC_NOTIFICATION_DELIVERY_AUTOPROCESS_ENABLED=true
PULSESOC_NOTIFICATION_DELIVERY_BATCH_SIZE=20

# Legacy SMS integrations
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Shared real-time audio foundation rollout. All V2 feature switches require
# the master flag. Defaults preserve the current route with an immediate kill
# switch and an explicit legacy fallback during QA.
REALTIME_AUDIO_PLATFORM_V2_ENABLED=false
# Canonical shared-path flags. The older V2 names below remain temporary aliases.
REALTIME_AUDIO_CALLS_SHARED_PATH=false
REALTIME_VIDEO_CALLS_SHARED_PATH=false
REALTIME_LIVE_SHARED_PATH=false
REALTIME_AUDIO_CALLS_V2_ENABLED=false
REALTIME_VIDEO_CALLS_V2_ENABLED=false
REALTIME_AUDIO_V2_FALLBACK_ENABLED=true
LIVESTREAM_AUDIO_V2_ENABLED=false
LIVESTREAM_AUDIO_V2_QA_ONLY=true
LIVESTREAM_AUDIO_V2_PERCENT=0
LIVESTREAM_AUDIO_V2_FALLBACK_ENABLED=true
# Optional: custom TURN/STUN for restrictive networks (falls back to defaults).
TURN_SERVER_URL=
STUN_SERVER_URL=
# PulseSoc server-side translation (Google Cloud Translation Advanced)
# Railway go-live checklist:
#   1. TRANSLATION_ENABLED=true
#   2. TRANSLATION_QA_ONLY=false (or add your user id to TRANSLATION_QA_USER_IDS)
#   3. GOOGLE_CLOUD_PROJECT_ID + GOOGLE_CLOUD_TRANSLATION_CREDENTIALS_JSON
#      (full service-account JSON, escaped \n in private_key is tolerated).
#      A service account is the only credential that works: this integration
#      speaks Cloud Translation v3, and v3 rejects API keys with 401
#      CREDENTIALS_MISSING. There is no GOOGLE_CLOUD_TRANSLATION_API_KEY.
#   4. Verify: GET /internal/health/translation?probe=1 → healthy:true
#      Without ?probe=1 this only reports that a credential is well-formed, not
#      that Google accepts it. Use the probe before believing the go-live.
TRANSLATION_ENABLED=false
TRANSLATION_QA_ONLY=true
TRANSLATION_QA_USER_IDS=
TRANSLATION_PRIMARY_PROVIDER=google
TRANSLATION_CACHE_ENABLED=true
TRANSLATION_CACHE_TTL_SECONDS=86400
TRANSLATION_REQUEST_TIMEOUT_SECONDS=10
TRANSLATION_MAX_RETRIES=2
TRANSLATION_MODERATION_BEFORE_TRANSLATION=true
TRANSLATION_MODERATION_AFTER_TRANSLATION=true
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_CLOUD_TRANSLATION_LOCATION=global
GOOGLE_CLOUD_TRANSLATION_CREDENTIALS_JSON=

# --- Analytics instrumentation ---------------------------------------------
# Request-level visitor logging (populates visitor_logs, which backs the
# "Visitors - 24h" KPI, the Live Visitors page, and Visitor Intelligence).
# DEFAULTS TO OFF. While it is off those surfaces report a truthful-looking 0
# that actually means "not instrumented". Set to true to measure visitors.
# Cost: one SELECT + INSERT + COMMIT per non-/api/ page request, deduplicated
# per session+path per minute.
PULSESOC_VISITOR_LOGGING_ENABLED=false

# ============================================================================
# VARIABLES READ BY PRODUCTION CODE BUT PREVIOUSLY UNDOCUMENTED
# ============================================================================
# Added during the backend operations recovery audit (Aug 2026).
#
# Every key below is read by bot.py, services/, a worker, or
# pulse_communications_v2/ at runtime. None of them appeared in this file, so
# an operator provisioning a fresh environment from .env.example got a boot
# with media storage, live streaming, Telegram, Twilio and Redis silently
# unconfigured. Because optional route packs register inside `except`
# blocks, the resulting failure mode is a surface that 404s or returns empty
# rather than a startup error - which is exactly the class of problem this
# audit exists to remove.
#
# Values shown are the defaults the code itself falls back to. A blank value
# means the code has no default and the feature is off until it is set.
# Secrets are intentionally left blank - fill them from the provider console.
#
# Where two names appear for one setting, both are accepted; the first is
# preferred (e.g. R2_BUCKET is checked before S3_BUCKET).

# --- Cloudflare R2 / object storage (media, uploads, replays) ------------------
AWS_ACCESS_KEY_ID=
AWS_REGION=auto
AWS_SECRET_ACCESS_KEY=
R2_ACCESS_KEY_ID=
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ENDPOINT=
R2_ENDPOINT_URL=
R2_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_ENDPOINT_URL=

# --- Mux - live streaming and VOD ----------------------------------------------
MUX_API_TIMEOUT_SECONDS=12
MUX_ASSET_CREATE_TIMEOUT_SECONDS=8
MUX_ASSET_FETCH_TIMEOUT_SECONDS=12
MUX_ASSET_GET_TIMEOUT_SECONDS=8
MUX_DATA_ANALYTICS_ENABLED=
MUX_DATA_ENV_KEY=
MUX_DIRECT_UPLOAD_TIMEOUT_SECONDS=12
MUX_LIVE_CREATE_TIMEOUT_SECONDS=10
MUX_LIVE_DISABLE_TIMEOUT_SECONDS=8
MUX_LIVE_GET_TIMEOUT_SECONDS=8
MUX_LIVE_RECONNECT_WINDOW_SECONDS=60
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_WEBHOOK_SECRET=
# Mux signing key pair for SIGNED playback URLs, distinct from the API token
# above. Both must be set or signed_playback_url() returns empty rather than
# falling back to an unsigned URL — so leaving these blank makes signed-playback
# streams unplayable, it does not silently serve them in the clear.
# MUX_SIGNING_PRIVATE_KEY accepts either a PEM block or its base64 form.
MUX_SIGNING_KEY_ID=
MUX_SIGNING_PRIVATE_KEY=

PULSESOC_CALL_CONNECTED_STALE_SECONDS=21600
PULSESOC_CALL_CONNECTING_STALE_SECONDS=120
PULSESOC_CALL_CREATED_STALE_SECONDS=60
PULSESOC_CALL_RECONNECTING_STALE_SECONDS=180

# --- Telegram ------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=

# --- Twilio - SMS and voice ----------------------------------------------------
COMM_V2_TWILIO_DRY_RUN=
COMM_V2_TWILIO_NOTIFICATIONS_ENABLED=
TWILIO_FROM_NUMBER=

# --- Redis - cache and queues --------------------------------------------------
REDIS_URL=

# --- Push notifications (APNs / FCM / Expo) ------------------------------------
PUSH_BADGE_ENABLED=1
PUSH_DEFAULT_SOUND=
PUSH_ENVIRONMENT=
