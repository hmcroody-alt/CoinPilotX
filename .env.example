PERFORMANCE_TRACE_PERSIST_ENABLED=
# --- PostgreSQL lock health monitor (services/pg_lock_health.py) -------------
# Watches the two signals that were available and unwatched throughout the
# 2026-09-19 outage: the deadlock counter's *rate*, and how many sessions are
# parked on a lock. See docs/incidents/WEBSITE_OUTAGE_2026-09-19_REPORT.md.
# Set to 0 to stop sampling entirely. Sampling opens its own short-lived
# read-only connection rather than borrowing from the pool, so leaving it on
# costs one connection per alert-worker cycle and never competes for a pool slot.
PG_LOCK_ALERT_ENABLED=1
# pg_stat_database.deadlocks is cumulative, so the threshold is on the delta
# between consecutive cycles. A healthy PulseSoc day produces zero; the incident
# produced roughly five a minute. 3/min is comfortably above noise and well
# below the rate at which requests start timing out.
PG_DEADLOCKS_PER_MIN_THRESHOLD=3
# Sessions in pg_stat_activity with wait_event_type='Lock'. Ordinary contention
# shows one or two for a few milliseconds; a convoy shows every worker at once.
# Sized against the 8+8 pool so this fires while requests are still being served.
PG_LOCK_WAITERS_THRESHOLD=5
# A separate trigger for the other shape of the same failure: a single session
# stuck for a long time, which the count threshold above would never see.
PG_LOCK_WAIT_SECONDS_THRESHOLD=30
# Minimum gap between two alert *emails*. The ERROR log line is not suppressed —
# it is the forensic record, and the gap in it is what made the incident
# timeline hard to rebuild.
PG_LOCK_ALERT_COOLDOWN_SECONDS=900
# statement_timeout and connect_timeout for the probe. A sample that cannot be
# taken quickly is itself the finding and is reported as one, so this stays low.
PG_LOCK_SAMPLE_TIMEOUT_MS=3000
# Where alerts go. Required in practice: the OWNER_ADMIN_EMAIL fallback reads an
# environment variable, but bot.py:545 defines OWNER_ADMIN_EMAIL as a Python
# literal, so nothing sets the variable the fallback looks for. With neither set
# the monitor still runs and still logs, it just has no one to tell.
# Delivery goes through Brevo and needs BREVO_API_KEY on the alert_worker
# service too; that service has no key of its own by default.
PG_LOCK_ALERT_EMAIL=
