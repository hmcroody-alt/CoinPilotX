# --- Founder allocation policy -------------------------------------------------
# Founder membership is sold as a founding cohort at a locked lifetime price, but
# allocation was governed only by `MAX(founder_number) + 1`. Sequential numbering
# guarantees uniqueness, NOT scarcity — so the cohort was effectively unlimited.
# These two variables make the policy explicit. Both unset = open and uncapped,
# which is the historic behaviour (so leaving them blank changes nothing).
# Maximum number of founder memberships that may ever be issued. Blank/0 =
# uncapped. Counts numbers ISSUED, including revoked ones, because a number is
# never reused — an active-only count would let churn grow the cohort past its cap.
PULSE_FOUNDER_ALLOCATION_LIMIT=
# Set to 1 to stop issuing NEW founder memberships immediately. Existing founders
# are unaffected and can always be re-granted (reactivation, replayed webhook,
# admin repair) — closing the cohort must never strip a member who already holds
# a number.
PULSE_FOUNDER_ALLOCATION_CLOSED=

# --- Sentinel kill switches ----------------------------------------------------
# Precedence: emergency > master > per-domain > per-runbook. High-risk automation
# needs four explicit opt-ins and can be revoked at any layer instantly.
# Set to 1 to kill ALL Sentinel activity, including read-only ingest. No exceptions.
SENTINEL_EMERGENCY_KILL_SWITCH=
# Master gate for every Sentinel AUTOMATION action. DEFAULT OFF: if unset, no
# automation runs at all, so a runbook enabled below still will not fire.
SENTINEL_AUTOMATION_ENABLED=
# Master gate for financial DETECTION (read-only analysis, no state mutation).
# DEFAULT OFF: if unset, financial fraud signals are not evaluated.
SENTINEL_FINANCIAL_DETECTION_ENABLED=
# Observation/ingest. DEFAULT ON when unset, because observation is how Sentinel
# maintains evidence and it never mutates state. Set to 0 to silence intake —
# note that doing so blinds every detection that depends on it.
SENTINEL_INGEST_ENABLED=

# --- Sentinel external intelligence (all provider calls default OFF) ---------
# Master gate for bounded, read-only external intelligence. Leave unset until
# the provider-specific scope and credentials have been verified in production.
SENTINEL_EXTERNAL_INTEL_ENABLED=
# Public CISA Known Exploited Vulnerabilities feed; override only for an
# approved HTTPS mirror. Unset uses CISA's official public feed.
CISA_KEV_FEED_URL=
# Exact repository scope for read-only GitHub security alerts (owner/repository).
