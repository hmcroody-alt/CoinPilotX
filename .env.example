# --- Read through dynamic dispatch (no name appears at the getenv call site) ---
# undx_router reads `os.getenv(config.key_env)` where key_env came from a
# ProviderConfig literal, and pulsesoc_intelligence_engine loops over each
# source's `required_env` list. Neither spelling is visible to a grep for
# getenv(, which is why these went undocumented longest of all.

# AI model overrides. Unset is safe - undx_router falls back to the default shown.
# (OPENAI_MODEL is declared above with the same default.)
#
# The two values below were `claude-3-5-haiku-latest` and `gemini-1.5-flash`.
# Both have been retired upstream and now 404 on every request, which was the
# entire "Claude and Gemini are dead in production" outage - neither credential
# was ever wrong. Anyone who copied this file into a new environment got the
# outage with it, and failover hid it behind HTTP 200s.
#
# A model ID pinned here is a thing that expires. If you set one, own the job of
# checking it still resolves; scripts/undx_provider_health_check.py is how.
CLAUDE_MODEL=claude-haiku-4-5
GEMINI_MODEL=gemini-flash-lite-latest
DEEPSEEK_MODEL=deepseek-chat
GROQ_MODEL=llama-3.1-8b-instant

# Intelligence-engine market and news sources. All are paid third-party APIs and
# all are optional: services/pulsesoc_intelligence_engine.py marks a source
# unavailable when its required_env is unset rather than failing the stream, so
# an unset key here removes that source from the feed without any error surfacing.
ALPHA_VANTAGE_API_KEY=
AP_NEWS_API_KEY=
FINNHUB_API_KEY=
POLYGON_API_KEY=
REUTERS_API_KEY=

# pulsesoc-ads-worker (pulse_ads_worker.py). All optional with safe defaults:
# the worker drains the pulse_ad_jobs queue and runs operations/attribution/
# billing/reporting cycles. Unset values fall back to the defaults shown.
ADS_WORKER_SLEEP_SECONDS=20
ADS_WORKER_BATCH_SIZE=20
ADS_WORKER_ATTRIBUTION_SECONDS=300
ADS_WORKER_BILLING_SECONDS=600
ADS_WORKER_REPORTING_SECONDS=300
ADS_WORKER_BACKOFF_BASE_SECONDS=30
ADS_WORKER_BACKOFF_CAP_SECONDS=3600
ADS_WORKER_MAX_ATTEMPTS=5

# --- Agora real-time media (RTC, cloud recording, RTMP/Mux bridge) ---
# Agora is PulseSoc's sole native RTC provider for calls and Live. APP_ID and
# APP_CERTIFICATE are required for token minting: without them token generation
# fails and no call or broadcast can connect. The REST customer credentials are a
# separate HTTP Basic pair from the Agora console and are needed only for cloud
# recording and the RTMP bridge, both of which fail closed when they are unset.
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
AGORA_REST_CUSTOMER_ID=
AGORA_REST_CUSTOMER_SECRET=
# Optional tuning; unset falls back to the default shown.
AGORA_TOKEN_TTL_SECONDS=3600
AGORA_RECORDING_TIMEOUT_SECONDS=20
AGORA_MEDIA_PUSH_IDLE_TIMEOUT_SECONDS=300
# Unset means Agora picks the region automatically.
AGORA_MEDIA_PUSH_REGION=
# TTL for the signed R2 URLs handed to Mux when a recording is bridged out.
R2_MUX_SIGNED_URL_TTL_SECONDS=7200
# Both in BYTES, and both govern the R2->R2 join that turns Agora's private HLS
# segments into the single .ts file Mux ingests. MAX_BYTES is the ceiling on the
# summed segment size (default 32 GiB); over it the replay is refused as
# 'recording_too_large', which the worker does not treat as retryable - the job
# burns its attempts and the session ends at 'replay_failed'. So setting this low
# does not shorten a replay, it loses it.
# PART_BYTES is the exact multipart part size (default 16 MiB), not a minimum:
# R2 requires every non-final part to be identical, so the join flushes in this
# slice. Values under R2's 5 MiB floor are clamped, so lowering it past that does
# nothing; raising it raises media_worker's resident memory, because a part is
# held whole in the buffer, and anything over R2's 5 GiB per-part limit is
# rejected outright.
# The two interact: a multipart upload is capped at 10,000 parts, so the real
# size ceiling is PART_BYTES x 10,000 - 156 GiB at the default, 48 GiB at the
# 5 MiB floor. Raise MAX_BYTES above that and an oversized recording fails deep
# in the upload as a generic 'mux_input_failed' instead of being rejected up
# front with a reason that names the cause.
R2_MUX_INPUT_MAX_BYTES=34359738368
R2_MUX_INPUT_PART_BYTES=16777216
# Ceilings on a single multi-party CALL (not a Live). Raising these raises the
# number of simultaneous publishers one device has to decode, so they are a
# device-performance limit rather than a licensing one.
CALL_MAX_VIDEO_PARTICIPANTS=6
CALL_MAX_AUDIO_PARTICIPANTS=12

# --- Media upload sessions (direct-to-R2 and multipart) ---
# Videos above the multipart threshold are uploaded in parts straight to R2
# instead of through the web dyno. Defaults are sized for Railway's request
# limits; raising the threshold pushes large uploads back through the app server.
MEDIA_UPLOAD_MULTIPART_THRESHOLD_MB=16
MEDIA_UPLOAD_PART_SIZE_MB=8
MEDIA_UPLOAD_SESSION_TTL_SECONDS=3600
MEDIA_UPLOAD_SIGNED_URL_TTL_SECONDS=600
MEDIA_UPLOAD_MAX_STATUS_VIDEO_MB=350

# --- Marketplace checkout ---
# APPLE_PAY_MERCHANT_ID is optional: unset simply hides the Apple Pay option.
# MARKETPLACE_SHIPPING_COUNTRIES is a comma-separated ISO-3166 alpha-2 list.
APPLE_PAY_MERCHANT_ID=
MARKETPLACE_SHIPPING_COUNTRIES=US

# --- Marketplace standard seller fee policy (v1) ---
# All three gates must be satisfied before the fee policy charges anything;
# any one of them left unset keeps the policy safely inactive. They are separate
# variables rather than one switch because they represent three different people
# signing off: the owner approving the commercial terms, the disclosure actually
# being live in front of sellers, and the date it takes effect.
# MARKETPLACE_STANDARD_V1_EFFECTIVE_AT is an ISO-8601 timestamp; the policy stays
# inactive until that moment passes.
MARKETPLACE_STANDARD_V1_OWNER_APPROVED=
MARKETPLACE_STANDARD_V1_SELLER_DISCLOSURE_READY=
MARKETPLACE_STANDARD_V1_EFFECTIVE_AT=

# --- Marketplace card payments ---
# The global switch on the Marketplace card rail. Cash, local pickup and
# in-person settlement are unaffected by it and stay open either way.
#
# Off when unset, blank, false, or anything unrecognised — an operator who
# mistypes the value gets the pause, not a live card rail. Only "1", "true",
# "yes", "on" or "enabled" turn it on.
#
# Turning it on says the rail exists. It does not say any particular seller may
# use it: Connect onboarding, charges_enabled, payouts_enabled and outstanding
# requirements are checked per seller afterwards, and any one of them still
# blocks the checkout.
MARKETPLACE_CARD_PAYMENTS_ENABLED=

# --- Marketplace order fulfillment timeouts ---
# Whole hours. Unset, blank, zero or unparseable all mean the same thing: the
# order never advances on its own and a human has to move it. These are the only
# two transitions in the fulfillment model with nobody behind them, so the value
# a misconfigured deployment falls back to has to be the one that does nothing.
#
# MARKETPLACE_AUTO_DELIVER_AFTER_SHIPPED_HOURS closes the gap where a buyer
# receives their order and simply never says so, which would otherwise strand the
# seller's earnings forever. It applies only to shipped orders, which carry a
# tracking reference; local pickup has no third party to corroborate a handover
# and is deliberately given no timeout at all — there, only the buyer or an admin
# can confirm.
#
# MARKETPLACE_AUTO_COMPLETE_AFTER_DELIVERY_HOURS runs after delivery and is about
# closing the order record, not about releasing money: the settlement protection
# window is a separate, independently configured hold.
MARKETPLACE_AUTO_DELIVER_AFTER_SHIPPED_HOURS=
MARKETPLACE_AUTO_COMPLETE_AFTER_DELIVERY_HOURS=

# --- Marketplace settlement hold ---
# Whole hours between a confirmed delivery and the seller's earnings becoming
# eligible for transfer and payout. Blank means the documented default of 48
# hours, and so does anything unparseable or negative.
#
# Note the fallback runs the opposite way to the fulfillment timeouts above, on
# purpose. There, a bad value leaves an order sitting where it is; here, falling
# back to zero would release the money the instant delivery was confirmed, so a
# typo in a deployment variable must not be able to pay a seller early. An
# explicit 0 is honoured — waiving the hold is the owner's decision to make, and
# a variable that silently overrode it would be a lie.
MARKETPLACE_SETTLEMENT_HOLD_HOURS=

# --- Marketplace release cycle ---
# The two unattended steps between a shipped order and an eligible payout,
# hosted by pulse_worker. Neither moves money: the fulfillment sweep advances an
# order's state and the settlement sweep grants permission to pay, and both
# payout-worker switches below still stand between `eligible` and a transfer.
#
# MARKETPLACE_FULFILLMENT_SWEEP_ENABLED runs the timeout sweeper that applies
# the two AUTO_ variables above. With those blank it has nothing to do, so this
# flag is the second of two conditions rather than a duplicate of the first.
#
# MARKETPLACE_SETTLEMENT_SWEEP_ENABLED promotes settlements whose hold has
# elapsed from protection_hold to eligible. Before this existed nothing did, and
# every delivered order stayed in protection_hold permanently.
#
# MARKETPLACE_RELEASE_CYCLE_SECONDS is clamped to 60-3600 (default 300). Both
# flags are off when unset, blank or unparseable.
MARKETPLACE_FULFILLMENT_SWEEP_ENABLED=
MARKETPLACE_SETTLEMENT_SWEEP_ENABLED=
MARKETPLACE_RELEASE_CYCLE_SECONDS=

# --- Payments reconciliation sweep ---
# The unattended caller for services/business_os/payments/reconciliation.py, also
# hosted by pulse_worker. It is strictly detect-and-report: it opens financial
# incidents describing drift and never repairs, re-queues or transitions
# anything, so switching it on cannot move a cent in either direction.
#
# What it finds that nothing else can: ledger and ad-wallet drift, dead-lettered
# webhooks, funds stranded in suspense, stale seller payouts, and the marketplace
# settlement rows that stopped somewhere in the chain with the seller's money
# still on the platform's side — a settlement 'scheduled' with no provider payout
# id can never be matched by a Stripe webhook, so nothing would ever move it
# again. From the ledger's point of view that money is exactly where it belongs,
# which is why it needs its own check.
#
# Findings land as incidents (financial_incidents) and in the worker heartbeat.
# `last_reconciliation_critical_open` is standing state, not this run's output:
# a sweep that finds nothing new while yesterday's critical is still open is not
# a clean sweep, and an operator reading only the per-run count would think it
# was. A nonzero count also logs PAYMENTS_RECONCILIATION_CRITICAL at ERROR.
#
# PAYMENTS_RECONCILIATION_SECONDS is clamped to 300-86400 (default 3600); every
# condition it detects is measured in hours or days, and the sweep is the most
# expensive read in the worker. Off when unset, blank or unparseable.
PAYMENTS_RECONCILIATION_ENABLED=
PAYMENTS_RECONCILIATION_SECONDS=

# --- Marketplace payout worker ---
# The scheduler that moves a seller's cleared earnings out of the platform
# balance: first a Stripe transfer to their connected account, then a payout to
# their bank. Both legs are irreversible from this platform's side — money can be
# requested back from a seller, not taken back — so mutation is behind two
# independent switches rather than one, and every flag is off when unset, blank
# or unparseable.
#
# MARKETPLACE_PAYOUT_WORKER_ENABLED alone is safe: the cycle runs read-only and
# reports what it *would* pay, which is the evidence for deciding to open the
# other two. Money only moves when DRY_RUN is explicitly false AND
# OWNER_AUTHORIZED is explicitly true. The worker additionally refuses to move
# money unless the database is Postgres, because that is the only engine where it
# can hold a leader lock across replicas.
#
# MARKETPLACE_PAYOUT_WORKER_SECONDS is clamped to 60-3600 (default 600) and
# MARKETPLACE_PAYOUT_WORKER_BATCH to 1-200 (default 25), so a typo cannot produce
# a hot loop or an unbounded batch.
MARKETPLACE_PAYOUT_WORKER_ENABLED=
MARKETPLACE_PAYOUT_WORKER_DRY_RUN=
MARKETPLACE_PAYOUT_WORKER_OWNER_AUTHORIZED=
MARKETPLACE_PAYOUT_WORKER_SECONDS=
MARKETPLACE_PAYOUT_WORKER_BATCH=
#
# Retry budget for a payout submission that failed. Only failures the scheduler
# can name as transient — a connection reset, a rate limit, a Stripe API error —
# are retried at all; a closed bank account or an unrecognised error is never
# retried, because repeating a call that can only fail is a way of not telling
# anyone. Attempts and the next attempt time are stored on the settlement row,
# so a redeploy does not hand every stranded payout a fresh budget.
#
# MARKETPLACE_PAYOUT_RETRY_MAX_ATTEMPTS is clamped to 1-10 (default 5),
# MARKETPLACE_PAYOUT_RETRY_BASE_SECONDS to 60-86400 (default 900) and
# MARKETPLACE_PAYOUT_RETRY_MAX_SECONDS to 60-604800 (default 21600). Backoff
# doubles from the base and is capped at the max. When the budget runs out the
# settlement is fenced with a blocker_code and a SUSPENSE_FUNDS_HELD incident is
# opened; the money stays where it is until an operator releases the hold.
MARKETPLACE_PAYOUT_RETRY_MAX_ATTEMPTS=
MARKETPLACE_PAYOUT_RETRY_BASE_SECONDS=
MARKETPLACE_PAYOUT_RETRY_MAX_SECONDS=

# --- Progress OS (Founding Member Challenge) ---
# HMAC key for the opaque `ref` tokens the Progress Center uses to address a
# referral. Falls back to SECRET_KEY, then to a build-time constant. The token
# is an addressing handle, not a credential — it is only ever resolved against
# rows already scoped to the viewer — so leaving this unset degrades
# unguessability, not access control. Set it anyway in production.
PROGRESS_REF_SECRET=

# --- Insight automated image pipeline ---
# Contextual image generation for automated posts. Every value below has a
# working default, so the pipeline runs unconfigured; these exist to let an
# operator throttle cost and blast radius without a deploy.
#
# The two caps and the circuit breaker are the safety envelope. They are the
# difference between a stuck generation loop costing a few images and it
# costing a day of quota, so raising them is a spend decision, not a tuning one.
PULSE_INSIGHT_IMAGE_MODEL=
# Seconds to wait on the image API before giving up. Default 90.
PULSE_INSIGHT_IMAGE_TIMEOUT_SECONDS=
# Largest image accepted from the provider, in bytes. Default 12582912 (12 MiB).
# Oversized responses are dropped rather than stored.
PULSE_INSIGHT_IMAGE_MAX_BYTES=
# Retries per post before the job is abandoned. Default 2.
PULSE_INSIGHT_IMAGE_MAX_ATTEMPTS=
# Generations allowed per hour. Default 4.
PULSE_INSIGHT_IMAGE_HOURLY_CAP=
# Generations allowed per day. Default 24.
PULSE_INSIGHT_IMAGE_DAILY_CAP=
# Window the circuit breaker looks back over, in minutes. Default 15.
PULSE_INSIGHT_IMAGE_CIRCUIT_MINUTES=
# Failures inside that window that trip the breaker and pause generation.
# Default 3. Set higher only if a flaky provider is starving a healthy queue.
PULSE_INSIGHT_IMAGE_CIRCUIT_FAILURES=

# --- Pulse Briefings (network + crypto intelligence pushes) -----------------
# Kill switch: stops scheduled briefing sends only; normal notifications
# are unaffected. Set to true in an incident.
BRIEFINGS_DISABLED=
# Master enable (default true). BRIEFINGS_DISABLED wins if both are set.
PULSE_BRIEFINGS_ENABLED=
# Max users evaluated per alert_worker cycle. Default 50.
BRIEFING_CYCLE_BATCH_LIMIT=
# Hard cap on sends per cycle regardless of batch limit. Default 200.
BRIEFING_SEND_RATE_CAP=
# Per-user deterministic send jitter after a window opens, minutes. Default 25.
BRIEFING_JITTER_MINUTES=
# Accounts younger than this never receive briefings. Default 24.
BRIEFING_MIN_ACCOUNT_AGE_HOURS=
# Briefing history retention, days. Default 60.
BRIEFING_HISTORY_RETENTION_DAYS=
# Shared market snapshot cache TTLs, seconds. One provider call feeds all users.
BRIEFING_MARKET_OVERVIEW_TTL=
BRIEFING_MARKET_MOVERS_TTL=
BRIEFING_MARKET_TRENDING_TTL=
# Snapshots older than this are omitted from briefings, never shown. Default 1800.
BRIEFING_MARKET_STALE_MAX=
# Provider HTTP timeout, seconds. Default 8.
BRIEFING_MARKET_TIMEOUT=

# --- Private Office ---------------------------------------------------------
# Per-feature runtime kill switches for services/private_office. These do NOT
# grant access: entitlement is resolved server-side from the member's tier by
# services/private_office/tiers.py, and a flag can only take away a feature the
# member is already entitled to. Turning one off makes the feature report
# FEATURE_DISABLED rather than 404 or silently returning empty, so the client
# can say why.
#
# POLARITY — READ THIS BEFORE SETTING ONE IN PRODUCTION.
# Absent means ENABLED. An unset or empty variable is read as "not overridden",
# not as "off" (services/private_office/feature_matrix.py:_flag_enabled). Only
# the literal values 1, true, on, yes enable; ANY other non-empty value —
# including "0", "false", and a typo like "ture" — disables. So the fail-safe
# direction here is different at each end: forgetting the variable leaves the
# feature ON, while fat-fingering the value turns it OFF. Deleting the line to
# re-enable a feature works; deleting it expecting a feature to stay off does
# not.
#
# Leaving these blank in .env is the correct default and matches production
# today. They exist so an operator can disable a private feature during an
# incident without a deploy.
#
# Kill switch for private facts capture and retrieval — the recorded-fact
# substrate behind /api/private-office/facts and the private.facts.list UNDX
# capability. Disabling stops reads and writes; it does not delete stored
# facts, and re-enabling exposes exactly what was there before.
PRIVATE_FACTS_ENABLED=
#
# Lifetime of a Private Office access grant, in seconds. Unset falls back to the
# 900s default; shortening it forces re-authorisation more often.
PRIVATE_OFFICE_GRANT_TTL_SECONDS=900
#
# Kill switch for the Capital Graph — the read-only view over the private
# graph behind /api/private-office/capital-graph, the two entity routes, and
# the private.capital.graph UNDX capability. Disabling stops those reads; it
# does not delete a node, an edge or a fact, and it does not disable the fact
# store, which has its own switch above. The two are separate on purpose: a
# problem in the traversal should not have to take fact capture down with it.
CAPITAL_GRAPH_ENABLED=
#
# Kill switch for the Portfolio → Capital Graph projection pipeline: the
# portfolio_outbox enqueue on Portfolio mutations and the drain that
# re-projects holdings into the private graph. Default on. Disabling stops
# new projections; already-projected nodes and facts stay readable (labelled
# by sync status as behind), and re-enabling catches up from the ledger via
# the next full re-projection — nothing is lost, only deferred.
PORTFOLIO_CAPITAL_PROJECTION_ENABLED=
#
# Kill switch for Private Office Operations — the six record primitives
# (obligations, events, decisions, requests, risks, opportunities) behind
# /api/private-office/records/*, /api/private-office/attention and the six
# private.*.list UNDX capabilities. Disabling stops reads and writes; it does
# not delete stored records, and re-enabling exposes exactly what was there
# before. Separate from the facts and graph switches on purpose: a problem in
# one store should not have to take the others down with it.
PRIVATE_OPERATIONS_ENABLED=
#
# Kill switch for the structured record store — the server-owned versioned
# template registry, the typed field projection and the step-up reveal behind
# /api/private-office/record-templates, /api/private-office/record-domains and
# /api/private-office/structured-records/*. Disabling stops reads and writes; it
# does not delete stored records, and re-enabling exposes exactly what was there
# before. Separate from the facts switch above on purpose: these are two stores
# with two shapes, and one switch over both would mean that turning off a
# template problem also takes away every fact a member has recorded.
#
# Note what this switch does *not* reach. Tenant isolation, passcode step-up on
# reveal, masking and encryption at rest are not behind it — they are properties
# of the store itself, so an operator disabling the feature during an incident
# cannot accidentally disable the parts that make it safe.
PRIVATE_STRUCTURED_RECORDS_ENABLED=
#
# Kill switch for Document Intelligence — the Private Office vault behind
# /api/private-office/documents/*. Disabling stops uploads, reads, content
# streaming and claim review; it does not delete stored documents, and
# re-enabling exposes exactly what was there before. Same polarity as the
# other Private Office switches: unset or truthy means ON, "false"/"0"/"off"
# means OFF.
PRIVATE_DOCUMENTS_ENABLED=
#
# Kill switch for Relationship Intelligence — the Private Office directory,
# profiles, cited timelines and briefing preparation behind
# /api/private-office/relationships/*. Disabling stops reads and person
# writes; it does not delete anything (people live in the private graph and
# fact stores, which keep their own switches), and re-enabling exposes exactly
# what was there before. Same polarity as the other Private Office switches:
# unset or truthy means ON, "false"/"0"/"off" means OFF.
PRIVATE_RELATIONSHIPS_ENABLED=
#
# Kill switch for Private Briefings — the on-demand, member-triggered briefing
# engine behind /api/private-office/briefings/*. Disabling stops generation,
# reads, Ask Why resolution and action creation; it does not delete stored
# briefings, and re-enabling exposes exactly what was there before. The engine
# schedules nothing and pushes nothing, so this switch never silences a
# notification — there are none. Same polarity as the other Private Office
# switches: unset or truthy means ON, "false"/"0"/"off" means OFF.
PRIVATE_BRIEFINGS_ENABLED=
#
# Kill switch for Private Shield — the internal exposure monitor behind
# /api/private-office/shield/*. Disabling stops scans, posture reads and
# finding updates; it does not delete recorded findings, and re-enabling
# exposes exactly what was there before. This switch covers only the internal
# checks — external breach monitoring is a separate matrix row that remains
# PROVIDER_REQUIRED until a provider is integrated, whatever this is set to.
# Same polarity as the other Private Office switches: unset or truthy means
# ON, "false"/"0"/"off" means OFF.
PRIVATE_SHIELD_ENABLED=
#
# Kill switch for the Human Concierge desk behind
# /api/private-office/concierge/*. Same polarity as the other Private Office
# switches: unset or truthy means ON, "false"/"0"/"off" means OFF.
PRIVATE_CONCIERGE_ENABLED=
#
# The concierge operator roster: comma-separated platform user ids of the
# real humans staffing the desk. This is the staffing truth the product
# renders — empty means the desk is UNSTAFFED and every concierge payload
# says so. It is also the authorization list for the operator console
# (/api/private-office/concierge/desk): accounts not on this list get 404s.
# Never put a service or bot account here; operator messages are presented
# to members as written by a human, because they are.
PRIVATE_CONCIERGE_OPERATOR_IDS=
#
# Master switch for Private Meetings — the Zoom-class multi-guest meeting
# system behind /api/private-office/meetings/*. OPPOSITE polarity to the
# older Private Office switches, on purpose (mission rule: fail closed):
# UNSET means OFF. Only an explicit truthy value ("1"/"true"/"on"/"yes")
# opens the surface; anything else keeps every meetings route answering 404.
# Disabling does not delete meeting history; re-enabling exposes exactly what
# was there before.
PRIVATE_MEETINGS_ENABLED=
#
# Recording metadata lifecycle inside Private Meetings. Also DEFAULT OFF
# (unset means OFF), and it only matters while PRIVATE_MEETINGS_ENABLED is
# on — recording is never available in a disabled meetings surface. This
# governs the requested/active/completed/failed metadata states and the
# visible indicator; actual media capture additionally requires the provider
# pipeline, and a recording that never went active is recorded as FAILED,
# never claimed as media.
PRIVATE_MEETINGS_RECORDING_ENABLED=
#
# Private Conversations: the Private Office view of messaging — thread
# classification, sensitivity and cross-domain links to documents, records,
# facts, meetings, organization nodes and projects, behind
# /api/private-office/conversations/*. DEFAULT OFF like the meetings switches:
# UNSET means OFF, and only an explicit truthy value opens the surface.
#
# Turning this off removes the OFFICE VIEW of those threads, not the threads
# themselves. Messages live in the canonical messaging ledger
# (pulse_communications_v2) and attachments in the canonical media foundation,
# so a disabled surface leaves every conversation intact and reachable in
# ordinary Messenger. Re-enabling restores the classification exactly as it
# was. Nothing on this path is end-to-end encrypted and no surface may claim
# that it is.
PRIVATE_CONVERSATIONS_ENABLED=

# Route-hit telemetry: the evidence the web rebuild's deletions are gated on.
# DEFAULT OFF — unset means OFF, and only "1"/"true"/"yes"/"on" turns it on.
#
# Records (url rule, method, client, day) counts so that "does anything still
# call this route?" is answered with a week of production traffic instead of a
# guess. The `client` split (native / web / bot / unknown) is the load-bearing
# part: a route the shipped App Store app still calls must not be deleted
# because the website stopped using it, and that client cannot be told to
# upgrade on our schedule.
#
# It never records the path, only the rule (`/pulse/post/<int:post_id>`), and
# never the user, IP or User-Agent — so there is no personal data in the table
# and its size is bounded by (rules x methods x clients x days) rather than by
# traffic. Cost per request is a dict increment under a lock; writes are
# batched and flushed on an interval.
#
# Turn this ON in production for at least a week before any route family is
# removed. With it off, the deletion gate has no evidence and must refuse.
PULSE_ROUTE_HIT_LOG_ENABLED=

# =============================================================================
# COMMERCE DISCOVERY (organic + house Marketplace promotion)
# =============================================================================
# Surfaces Marketplace products in Feed, Reels, Messenger and Marketplace
# *without* a seller paying for reach. Separate engine, separate tables,
# separate salt from BUSINESS_OS_AD_* — organic reach and paid reach must never
# be accountable as the same number. Code: services/commerce_discovery/.
#
# Every default is the conservative one: unset means LESS commerce, never more.
# Leave the whole block blank in a fresh environment and the engine runs at its
# shipped cadence. Set COMMERCE_DISCOVERY_ENABLED=false to stop it entirely
# without a client release — every surface already renders an empty placement
# list as "no commerce unit".

# Master kill switch, checked per request. Default true.
COMMERCE_DISCOVERY_ENABLED=
# Operator-level off switch for personalized ranking only. With this false the
# engine still serves, but on quality + freshness alone and every card reports
# reason="popular". Default true. (Users have their own separate setting.)
COMMERCE_DISCOVERY_PERSONALIZATION=
# Salt for the per-viewer hash written to commerce_discovery_* event rows, and
# the HMAC secret for placement tokens. MUST NOT be set to the same values as
# BUSINESS_OS_AD_SUBJECT_SALT / BUSINESS_OS_AD_TOKEN_SECRET: a shared salt would
# let one hash join an organic viewer to a paid viewer across the two stores.
COMMERCE_DISCOVERY_SUBJECT_SALT=
COMMERCE_DISCOVERY_TOKEN_SECRET=
# Seconds a served placement may still report an impression or click. Default
# 3600 — generous because no budget is being spent, only analytics freshness.
COMMERCE_DISCOVERY_PLACEMENT_TTL=

# --- cadence, per surface ---------------------------------------------------
# Feed: posts before the first unit, posts between units, units per page and
# per session. Defaults 6 / 8 / 2 / 6 (the mission's 6-10 band).
COMMERCE_DISCOVERY_FEED_LEAD_IN=
COMMERCE_DISCOVERY_FEED_INTERVAL=
COMMERCE_DISCOVERY_FEED_MAX_PER_PAGE=
COMMERCE_DISCOVERY_FEED_MAX_PER_SESSION=
# Reels is the most intrusive surface and gets the smallest budget: one chip
# per session, after 4 reels watched. Defaults 1 / 4 / 10.
# The interval only comes into play once MAX_PER_SESSION is raised above 1 —
# but it has to exist for that knob to be safe to turn, because without it a
# budget of 2 puts the second chip on the very next reel.
COMMERCE_DISCOVERY_REELS_MAX_PER_SESSION=
COMMERCE_DISCOVERY_REELS_LEAD_IN=
COMMERCE_DISCOVERY_REELS_INTERVAL=
# Messenger: the strip above the conversation list only. Never inside a chat.
# Default 1 per session.
COMMERCE_DISCOVERY_MESSENGER_MAX_PER_SESSION=
# Marketplace is the surface the user came to for commerce, so it is densest.
# Default 8 modules.
COMMERCE_DISCOVERY_MARKETPLACE_MODULES=
# Post detail: one card under a post the viewer chose to open. Counted per
# session rather than per screen, because the screen holds a single post -- a
# reader who opens twenty posts sees a product under six of them. Default 6.
COMMERCE_DISCOVERY_POST_DETAIL_MAX_PER_SESSION=

# --- relevance floor --------------------------------------------------------
# Score below which a surface shows NOTHING. "No placement is better than a bad
# placement", enforced as a number. Base default 0.35; Reels carries +0.20,
# Messenger +0.10, Marketplace -0.15 on top of whatever is set here.
COMMERCE_DISCOVERY_MIN_SCORE=

# --- frequency caps ---------------------------------------------------------
# Times one listing / one seller may be shown to one viewer inside the window
# (seconds). Defaults 3 per 7 days, 6 per 24 hours.
COMMERCE_DISCOVERY_PRODUCT_CAP=
COMMERCE_DISCOVERY_PRODUCT_WINDOW=
COMMERCE_DISCOVERY_SELLER_CAP=
COMMERCE_DISCOVERY_SELLER_WINDOW=
# Same, per category. Deliberately looser (default 10 per 24 hours) than the
# seller cap: someone shopping for shoes should keep seeing shoes. This exists
# to stop a category filling every slot, not to force variety on a viewer who
# has shown what they want.
COMMERCE_DISCOVERY_CATEGORY_CAP=
COMMERCE_DISCOVERY_CATEGORY_WINDOW=
# Length in days of the user-facing "hide Marketplace suggestions" snooze.
# Default 30. The Settings copy says 30 days; change both or neither.
COMMERCE_DISCOVERY_HIDE_DAYS=
# Per-viewer request budget on the discovery endpoints. Default 120 per 60s.
COMMERCE_DISCOVERY_RATE_MAX=
COMMERCE_DISCOVERY_RATE_WINDOW=

# --- cooldowns --------------------------------------------------------------
# Seconds before a listing / seller a viewer has just been shown is allowed back
# in. Where the caps above bound how OFTEN, these bound how SOON — a cap of 3 per
# week is satisfied by three placements in ten seconds. Defaults 21600 (6h) and
# 900 (15m). Each surface scales these: Reels doubles them, Marketplace cuts them
# to a quarter, because a shelf the viewer opened on purpose may legitimately
# repeat what their feed showed an hour ago.
COMMERCE_DISCOVERY_PRODUCT_COOLDOWN=
COMMERCE_DISCOVERY_SELLER_COOLDOWN=
# Shorter cooldown applied when the last impression was on a *different* surface.
# Default 1800 (30m). The same product in Feed, then Reels, then Messenger inside
# one minute reads as broken even though no single surface repeated itself.
COMMERCE_DISCOVERY_CROSS_SURFACE_COOLDOWN=
# How long a purchased listing stays suppressed. Default 7776000 (90 days).
COMMERCE_DISCOVERY_PURCHASE_SUPPRESSION=
# Window and row ceiling for the exposure history every cooldown above is read
# from. Defaults 604800 (7 days) and 600 rows — bounded on purpose, so a heavy
# session cannot turn one ranking pass into an unbounded scan.
COMMERCE_DISCOVERY_EXPOSURE_LOOKBACK=
COMMERCE_DISCOVERY_EXPOSURE_ROWS=

# --- candidate pool ---------------------------------------------------------
# Server-side pool feeding every surface. Batch fetched per query, pool size
# aimed for, level that triggers a refill, and the ceiling on refill rounds.
# Defaults 60 / 40 / 12 / 6. Refilling at a low watermark rather than at
# exhaustion is what keeps a scroll from stalling; MAX_BATCHES is the guard that
# stops a thoroughly-cooled-down catalogue from paging the whole table.
COMMERCE_DISCOVERY_CANDIDATE_BATCH=
COMMERCE_DISCOVERY_CANDIDATE_TARGET=
COMMERCE_DISCOVERY_CANDIDATE_LOW_WATER=
COMMERCE_DISCOVERY_CANDIDATE_MAX_BATCHES=
# Deterministic rotation: length of a rotation period in seconds and how many
# offset slots it is divided into. Defaults 3600 / 4. Two viewers with identical
# histories would otherwise see an identical ranking forever; this moves the
# starting offset so the tail of the catalogue gets reached.
COMMERCE_DISCOVERY_ROTATION_PERIOD=
COMMERCE_DISCOVERY_ROTATION_SLOTS=

# --- ranking ----------------------------------------------------------------
# Share of slots reserved for listings the ranker is unsure about. Without it
# the engine is rich-get-richer: a new seller's first product has no engagement
# signal, so it scores low and never earns the impressions that would fix that.
# Default 0.15, clamped to 0.5.
COMMERCE_DISCOVERY_EXPLORATION_RATE=
# Partial JSON override of the 12-term weight vector, e.g. {"freshness":0.12}.
# Unnamed terms keep their defaults; an unknown term is logged and ignored
# rather than accepted, so a typo cannot read as a successful retune.
# Defaults live in services/commerce_discovery/config.py:DEFAULT_WEIGHTS.
COMMERCE_DISCOVERY_WEIGHTS=

# --- PulseExperiments -------------------------------------------------------
# Deterministic A/B assignment. An arm is computed from the salt below rather
# than stored, so there is no assignment table that can drift from the code.
#
# The salt mixed into every bucket hash. Deliberately separate from
# COMMERCE_DISCOVERY_SUBJECT_SALT: a shared salt would let an exported
# experiment assignment be joined onto the commerce behavioural profile that
# salt exists to protect.
#
# Changing this reshuffles every subject's arm at once. That is destructive
# mid-experiment — the before and after cannot be compared — which is why it is
# a deployment setting and not a form field. Unset uses a built-in default.
PULSE_EXPERIMENTS_ASSIGNMENT_SALT=
# Global kill switch. Unset or true evaluates experiments normally; false sends
# every subject to control, which is the product's behaviour before any
# experiment existed. Intended for an incident, where an operator should not
# have to work out which experiments were running first.
PULSE_EXPERIMENTS_ENABLED=

# --- PulseControlPlane ------------------------------------------------------
# Wave 1 of the capability cutover. Arms the request-path consultation in
# services/pulse_control_plane/runtime.py.
#
# Unset or falsy means the consultation is off and every request path behaves
# exactly as it did before wave 1 — that is the rollback, and it does not need
# a code deploy. Truthy *permits* arming; it does not by itself arm anything.
# The process must also verify the ten wave-1 rows in feature_flags against the
# capability registry at boot, and stays off if they disagree.
#
# This is not an override. It decides whether the control plane is asked, never
# what it answers, so it cannot turn a denial into an allow — there is no
# decision to override when it is off.
#
# Scope is the ten wave-1 keys only. marketplace_checkout and the premium rows
# are later waves and are refused by the allowlist regardless of this value.
PULSE_CONTROL_PLANE_CONSULTATION=

# --- UNDX agent authorisation and kill switches -----------------------------
# Read by services/undx_agent_policy.py, which holds the name of each variable in
# a module-level constant and passes the constant to os.getenv. Every flag here
# is authorisation-shaped: absent means no, and that is the safe reading.
#
# Unset the whole group and UNDX can answer questions and do nothing else.

# Master switch for the UNDX agent. Unset or falsy means the agent is inert; no
# reads, no writes, no capability selection.
UNDX_AGENT_ENABLED=
# Allow the agent to read application data on a user's behalf. Off means every
# read-shaped capability is refused, which is the documented default.
UNDX_AGENT_READS_ENABLED=
# Allow the agent to write. Off means refused. This is the one flag that decides
# whether an agent run can change anything a user would notice.
UNDX_AGENT_WRITES_ENABLED=
# Kill switch for agent writes, evaluated independently of
# UNDX_AGENT_WRITES_ENABLED so an incident does not require finding out which of
# the two is set. Truthy blocks writes regardless of everything else.
UNDX_AGENT_DISABLE_WRITES=
# The predecessor of UNDX_AGENT_DISABLE_WRITES, still read so a deployment that
# set only the old name keeps its kill switch. Truthy blocks writes.
UNDX_V4_DISABLE_WRITES=
# Comma-separated capability ids the agent may use. Empty means no allowlist is
# in force, which is not the same as allowing everything: the per-capability
# flags still apply.
UNDX_AGENT_ENABLED_CAPABILITIES=
# Comma-separated capability ids the agent may never use. Takes precedence over
# the allowlist, so a capability named in both is denied.
UNDX_AGENT_DISABLED_CAPABILITIES=
# Comma-separated numeric user ids forming the QA cohort. Empty means an empty
# cohort - nobody is in QA - rather than everybody.
UNDX_AGENT_QA_USER_IDS=

# --- UNDX legacy policy (v2 / v4 / v5) --------------------------------------
# Read by services/undx_policy.py through name-holding constants. These predate
# the Brain layer and are still evaluated on the request path.

# Request the v2 intelligence config. On its own this is not enough: v2 is
# enabled only when the requested flag is truthy *and* the config signature
# verifies, so leaving UNDX_V2_CONFIG_SHA256 unset keeps v2 off.
UNDX_V2_ENABLED=
# Expected SHA-256 of the v2 config file, hex, lowercase. Compared against the
# file actually on disk. Unset or mismatched means the signature is invalid and
# v2 stays off with blocker "v2 config hash is missing or invalid" - the
# pinning is fail-closed on purpose, so an unpinned config cannot load.
UNDX_V2_CONFIG_SHA256=
# Absolute path to the intelligence config. Unset uses the in-repo default.
UNDX_INTELLIGENCE_CONFIG_PATH=
# Allow v4 notification actions. Off means refused.
UNDX_V4_ACTIONS=
# Master switch for v5. Off means v5 is unavailable to every user regardless of
# the cohort and the per-feature flags below.
UNDX_V5_ENABLED=
# Allow v5 content search. Evaluated as enabled AND NOT UNDX_V5_DISABLE_SEARCH,
# so the kill switch below wins.
UNDX_V5_CONTENT_SEARCH=
# Kill switch for v5 content search. Truthy disables search even when
# UNDX_V5_CONTENT_SEARCH is on.
UNDX_V5_DISABLE_SEARCH=
# Allow v5 notification actions. Off means refused.
UNDX_V5_NOTIFICATION_ACTIONS=
# Comma-separated numeric user ids allowed to reach v5. Non-numeric entries are
# discarded rather than rejected loudly, so a typo shrinks the cohort silently.
UNDX_V5_QA_USER_IDS=

# --- UNDX capability planner -------------------------------------------------
# Read by services/undx_capability_planner.py through name-holding constants.

# Allow the planner to run. Off means capability selection stays on the existing
# path, which is the current production behaviour.
UNDX_CAPABILITY_PLANNER_ENABLED=
# Confidence floor below which a planned capability is not offered. Unset uses
# 0.55. Read as a float, so a value that does not parse falls back to it.
UNDX_CAPABILITY_PLANNER_MIN_CONFIDENCE=
# Comma-separated provider names the planner may call, in preference order.
# Empty means the planner has no provider and does not run.
UNDX_CAPABILITY_PLANNER_PROVIDER=
# Per-call timeout in seconds. Unset or unparseable uses 12.
UNDX_CAPABILITY_PLANNER_TIMEOUT_SECONDS=

# --- UNDX embedding diagnostic ----------------------------------------------
# Gate for the embedding probe in services/undx_embedding_diagnostic.py. The
# probe spends real money against the embedding provider, so it refuses to run
# unless this is explicitly truthy; unset means the diagnostic returns without
# calling anything.
UNDX_EMBEDDING_PROBE=

# --- Business OS assistant writes and confirmations -------------------------
# Read through name-holding constants in services/business_os/.

# Kill switch for advertising-assistant writes. Truthy leaves the assistant able
# to answer and unable to change anything.
BUSINESS_OS_ADVERTISING_ASSISTANT_DISABLE_WRITES=
# Seconds an advertising-assistant confirmation stays pending before it expires.
BUSINESS_OS_ADVERTISING_ASSISTANT_CONFIRM_TTL_SECONDS=
# Kill switch for marketplace-assistant writes. Truthy means answers only.
BUSINESS_OS_MARKETPLACE_ASSISTANT_DISABLE_WRITES=
# Seconds a marketplace-assistant confirmation stays pending before it expires.
BUSINESS_OS_MARKETPLACE_ASSISTANT_CONFIRM_TTL_SECONDS=
# Seconds a Business OS confirmation row stays pending. Unset uses 300, and the
# value is clamped to the module's own minimum and maximum rather than trusted,
# so an out-of-range number becomes a bound and not an error.
BUSINESS_OS_CONFIRMATION_TTL_SECONDS=

# --- Business OS ad delivery privacy ----------------------------------------
# Read by services/business_os/advertising/delivery_common.py. Both fall back to
# a literal constant compiled into the source when unset, so an unconfigured
# deployment does not fail - it runs with a salt and a signing secret that are
# the same in every deployment and readable by anyone with the repository. Set
# both to per-environment random values.

# Salt for the ad subject pseudonym. Unset uses the in-source default, which
# makes the pseudonym reproducible by anyone who can read the code.
BUSINESS_OS_AD_SUBJECT_SALT=
# HMAC secret for ad delivery tokens. Unset uses the in-source default, which
# means the tokens are forgeable. This is the one in this section to set first.
BUSINESS_OS_AD_TOKEN_SECRET=

# --- Marketplace reservation lifecycle ---------------------------------------
# Read through name-holding constants in pulse_worker.py and the reservation
# modules. These govern stock holds, so a misconfiguration is visible to buyers
# as either an oversell or a cart that will not release.

# Enable the reservation sweeper in pulse_worker. Unset means off: expired holds
# are not released until something else releases them.
MARKETPLACE_RESERVATION_SWEEPER_ENABLED=
# Run the sweeper without writing. Unset defaults to TRUE - dry run - so
# enabling the sweeper alone reports what it would do and changes nothing. Set
# this falsy to let it actually release holds.
MARKETPLACE_RESERVATION_SWEEPER_DRY_RUN=
# Seconds between sweeps. Unset uses 300 and the value is clamped to 60..300.
MARKETPLACE_RESERVATION_SWEEP_SECONDS=
# Rows examined per sweep. Unset or unparseable uses 50.
MARKETPLACE_RESERVATION_SWEEP_BATCH=
# Minimum seconds before a deferred reservation is looked at again. Unset uses
# 300.
MARKETPLACE_RESERVATION_SWEEP_RECHECK_SECONDS=
# How many times a reservation may be deferred before the hold is released.
# Unset uses 6.
MARKETPLACE_RESERVATION_MAX_DEFERRALS=
# Seconds a stock reservation is held. Unset uses 900 (15 minutes).
MARKETPLACE_RESERVATION_TTL_SECONDS=

# --- Private Office field encryption -----------------------------------------
# Read by services/private_office/field_crypto.py, which does AES-256-GCM with
# keys taken from the process environment. Unset is not a silent downgrade: the
# module raises rather than falling back to plaintext, and the writer refuses
# the field, so RESTRICTED values cannot be stored at all until a key exists.
# This protects database dumps, backups and replicas; it does not protect
# against anyone who already has the application's environment.

# The keyring, as id-to-key pairs. Empty means no key is configured and every
# RESTRICTED field write is declined.
PRIVATE_OFFICE_FIELD_KEYS=
# Which key id in the keyring is used for new writes. Existing values stay
# readable under the id they were written with.
PRIVATE_OFFICE_FIELD_KEY_ACTIVE=

# --- Trusted proxy and geo headers -------------------------------------------
# Read by services/client_address.py through name-holding constants. These decide
# which hop of X-Forwarded-For is believed to be the client, so they feed every
# rate limit, audit row and ip hash.

# How many proxy hops in front of the app are trusted. Unset or unparseable uses
# 1. Too high lets a client forge its own address by sending the header.
PULSESOC_TRUSTED_PROXY_HOPS=
# Name of the header carrying a trusted country or region, if the edge sets one.
# Empty means no geo header is read and geo is unknown rather than guessed.
PULSESOC_TRUSTED_GEO_HEADER=

# --- Communications v2 call types --------------------------------------------
# Read by pulse_communications_v2/flags.py at import time, via subflag_enabled,
# which defaults each to false. Because they are evaluated once at module import
# and not per request, a change needs a redeploy to take effect.
#
# These sit under PULSE_COMMUNICATIONS_V2_ENABLED: with that off, none of them
# does anything on its own.

# Allow voice notes.
PULSE_VOICE_NOTES_ENABLED=
# Allow one-to-one audio calls.
PULSE_AUDIO_CALLS_ENABLED=
# Allow one-to-one video calls.
PULSE_VIDEO_CALLS_ENABLED=
# Allow group calls.
PULSE_GROUP_CALLS_ENABLED=

# --- UNDX Brain flag catalog --------------------------------------------------
# Every entry below is declared once in services/undx_brain/config.py:CATALOG and
# read by config.resolve(), which calls os.environ.get(flag.name) for each one.
# The name therefore never appears at a getenv() call site, which is why this
# block went undocumented while the code read all of it.
#
# The purposes and defaults here are transcribed from those declarations. resolve()
# never raises: an unparseable value becomes a note and the documented default,
# and an unrecognised boolean is read as the default rather than as off, so a typo
# cannot quietly disable a flag whose safe state is on.
#
# UNDX_BRAIN_ENABLED is the master switch and is documented above with the rest of
# the activation group.

# Allow the Product Knowledge Brain to contribute retrieved source-derived
# records to a response. Off means retrieval returns empty and the response
# is built from live evidence alone, which is the current behaviour.
# Default '0'; absence denies the capability.
UNDX_BRAIN_KNOWLEDGE_ENABLED=

# Allow skill selection to consult the Skill Brain. Off means capability
# selection stays entirely inside undx_agent_runtime, unchanged.
# Default '0'; absence denies the capability.
UNDX_BRAIN_SKILLS_ENABLED=

# Allow the Memory Brain to read and write its memory classes. Off means no
# Brain-owned persistence occurs at all.
# Default '0'; absence denies the capability.
UNDX_BRAIN_MEMORY_ENABLED=

# Allow the bounded planner to build multi-step plans. Off means one step
# per request, which is the current behaviour.
# Default '0'; absence denies the capability.
UNDX_BRAIN_REASONING_ENABLED=

# Allow the Communication Brain to shape the final response. Off means
# undx_response_intelligence renders exactly as it does today.
# Default '0'; absence denies the capability.
UNDX_BRAIN_RESPONSE_ENABLED=

# Load the source-derived corpus at all. On by default because loading it is
# read-only, bounded, and authorises nothing; the authorisation-bearing
# switch is UNDX_BRAIN_KNOWLEDGE_ENABLED, which gates whether anything
# retrieved may reach a response.
# Default '1'; absence degrades the feature but the request survives.
UNDX_SOURCE_CORPUS_ENABLED=

# Repository-relative path to the corpus. Declared so a deployment can point
# at a pinned artifact; an absolute path outside the repository root is
# rejected by the ingester rather than followed.
# Default 'backend/undx/config/undx_training_v6_source_corpus.yaml'; absence
# degrades the feature but the request survives.
UNDX_SOURCE_CORPUS_PATH=

# The schema version this build knows how to read. A corpus declaring
# anything else is refused whole — a partially-understood corpus is worse
# than none, because the records it does parse look authoritative.
# Default '6.0'; absence denies the capability.
UNDX_SOURCE_CORPUS_SCHEMA_VERSION=

# Upper bound on ingested records. Guards against a regenerated corpus
# growing without anybody noticing the memory cost.
# Default '5000'; a bound or label, with no authorisation content.
UNDX_SOURCE_CORPUS_MAX_RECORDS=

# Hard ceiling on records that may enter a single model prompt, independent
# of what retrieval asks for. This is the variable that stops the corpus
# becoming one enormous prompt.
# Default '8'; a bound or label, with no authorisation content.
UNDX_SOURCE_CORPUS_MAX_CONTEXT_RECORDS=

# Refuse to serve retrieval from a corpus whose audit did not pass. On by
# default: the audit is what checks for secret-shaped and private-data-
# shaped content, and serving from an unaudited corpus is the one failure
# this whole subsystem exists to prevent.
# Default '1'; absence denies the capability.
UNDX_SOURCE_CORPUS_STRICT_AUDIT=

# Allow bounded retrieval to run. Distinct from the Brain knowledge flag:
# this one governs whether the index is queried, that one governs whether
# results may influence a response.
# Default '1'; absence degrades the feature but the request survives.
UNDX_KNOWLEDGE_RETRIEVAL_ENABLED=

# Maximum knowledge records returned by one retrieval call, before the
# context budget is applied.
# Default '6'; a bound or label, with no authorisation content.
UNDX_KNOWLEDGE_MAX_RESULTS=

# Character budget for all retrieved knowledge in one request. Characters
# rather than tokens because characters are what this process can count
# exactly, and a budget that is estimated is a budget that is occasionally
# exceeded.
# Default '4000'; a bound or label, with no authorisation content.
UNDX_KNOWLEDGE_MAX_CONTEXT_CHARS=

# Lowest trust level retrieval may return. Records below it are indexed but
# not served, so raising this narrows what UNDX will say without
# regenerating anything.
# Default 'source_mapped'; absence denies the capability.
UNDX_KNOWLEDGE_MIN_TRUST_LEVEL=

# Permit records that were found in source but mapped to no canonical
# domain. Off by default: an unmapped record is a filename and a summary,
# which is enough to sound authoritative and not enough to be right.
# Default '0'; absence denies the capability.
UNDX_KNOWLEDGE_ALLOW_SOURCE_DISCOVERED=

# Highest-precedence stop for governed UNDX reads, writes, and worker
# mission claims. No lower capability flag may override it.
# Default '0'; absence denies the capability. Declared required: running on
# the default is a misconfiguration worth reporting, not a working state.
UNDX_EMERGENCY_KILL_SWITCH=

# Global stop for all governed UNDX writes while leaving eligible reads
# online.
# Default '0'; absence denies the capability. Declared required: running on
# the default is a misconfiguration worth reporting, not a working state.
UNDX_WRITE_KILL_SWITCH=

# Stop governed UNDX reads independently of the write controls.
# Default '0'; absence denies the capability.
UNDX_READ_KILL_SWITCH=

# Declare that the server-side authorization gate is mandatory for writes.
# An explicit false value blocks the write surface.
# Default '1'; absence denies the capability. Declared required: running on
# the default is a misconfiguration worth reporting, not a working state.
UNDX_AGENT_REQUIRE_AUTHORIZATION=

# Declare that the durable idempotency gate is mandatory for writes.
# Default '1'; absence denies the capability. Declared required: running on
# the default is a misconfiguration worth reporting, not a working state.
UNDX_AGENT_REQUIRE_IDEMPOTENCY=

# Refuse a completion claim when independent verification fails or is
# unavailable.
# Default '1'; absence denies the capability. Declared required: running on
# the default is a misconfiguration worth reporting, not a working state.
UNDX_VERIFICATION_FAILURE_FAIL_CLOSED=

# Require verified success before a governed write can be called complete.
# Default '1'; absence denies the capability. Declared required: running on
# the default is a misconfiguration worth reporting, not a working state.
UNDX_COMPLETION_REQUIRE_VERIFIED_SUCCESS=

# Unsafe compatibility control. When enabled the write surface is blocked;
# an executor return value alone is never sufficient completion evidence.
# Default '0'; absence denies the capability.
UNDX_COMPLETION_ALLOW_EXECUTOR_ONLY_SUCCESS=

# Allow new persistent missions to opt into the existing bounded planner.
# Default '0'; absence denies the capability.
UNDX_PLANNER_ENABLED=

# Allow persistent task nodes from the canonical pulse_ai task graph to be
# worker managed.
# Default '0'; absence denies the capability.
UNDX_TASK_GRAPH_ENABLED=

# Allow the dedicated Railway worker to claim eligible persistent missions.
# Default '0'; absence denies the capability.
UNDX_WORKER_ENABLED=

# Stop mission advancement when policy, storage, or verification is
# unavailable.
# Default '1'; absence denies the capability. Declared required: running on
# the default is a misconfiguration worth reporting, not a working state.
UNDX_WORKER_FAIL_CLOSED=

# Persist the dedicated worker heartbeat in the shared database.
# Default '1'; absence degrades the feature but the request survives.
UNDX_WORKER_HEARTBEAT_ENABLED=

# Permit the worker to reclaim expired leases without replaying completed
# nodes.
# Default '1'; absence denies the capability.
UNDX_WORKER_RECONCILIATION_ENABLED=

# Permit canonical mission reconciliation after interrupted worker
# execution.
# Default '1'; absence denies the capability.
UNDX_RECONCILIATION_ENABLED=

# Fixed lease duration for one claimed mission.
# Default '90'; a bound or label, with no authorisation content.
UNDX_WORKER_LEASE_SECONDS=

# Allow the worker to execute agent runs the user already confirmed in a
# request.
# Default '0'; absence denies the capability.
UNDX_AGENT_RUNS_ENABLED=

# Fixed lease duration for one claimed agent run. Longer than the mission
# lease because a run calls a real executor rather than advancing a
# lifecycle node.
# Default '120'; a bound or label, with no authorisation content.
UNDX_AGENT_RUN_LEASE_SECONDS=

# How many times a single agent run may be claimed before it is dead-
# lettered. A claim is counted even when the container dies mid-execution,
# so this bounds crash loops as well as retries.
# Default '3'; a bound or label, with no authorisation content.
UNDX_AGENT_RUN_MAX_ATTEMPTS=

# Fixed delay between worker polls when no mission is advanced.
# Default '60'; a bound or label, with no authorisation content.
UNDX_WORKER_SLEEP_SECONDS=

# Must remain off. Runtime difficulty never increases a mission's fixed
# bounds.
# Default '0'; absence denies the capability. Declared required: running on
# the default is a misconfiguration worth reporting, not a working state.
UNDX_PLANNER_DYNAMIC_LIMIT_ESCALATION_ALLOWED=

# Attach bounded correlation identifiers to governed runtime evidence.
# Default '1'; absence degrades the feature but the request survives.
UNDX_CORRELATION_IDS_ENABLED=

# Emit aggregate verification outcomes without record content.
# Default '1'; absence degrades the feature but the request survives.
UNDX_VERIFICATION_METRICS_ENABLED=

# Measure aggregate governed tool latency without recording arguments.
# Default '1'; absence degrades the feature but the request survives.
UNDX_TOOL_LATENCY_ENABLED=

# Require independent read-back before any write is reported as done. On by
# default and fail-closed on an unparseable value: a missing verification
# setting must never be the reason verification was skipped.
# Default '1'; absence denies the capability. Declared required: running on
# the default is a misconfiguration worth reporting, not a working state.
UNDX_AGENT_REQUIRE_VERIFICATION=

# Require an audit receipt for every governed mutation.
# Default '1'; absence denies the capability. Declared required: running on
# the default is a misconfiguration worth reporting, not a working state.
UNDX_AGENT_REQUIRE_AUDIT=

# When a policy, verification, or audit component is unavailable, deny
# rather than proceed. Turning this off is a deliberate act with no
# legitimate production use; it exists so the fail-open path can be tested.
# Default '1'; absence denies the capability. Declared required: running on
# the default is a misconfiguration worth reporting, not a working state.
UNDX_AGENT_FAIL_CLOSED=

# Allow a bounded working context to be assembled for one request. Off means
# the workspace accepts nothing and every caller sees an empty one, which is
# the current behaviour: context is assembled by each call site as it is
# today.
# Default '0'; absence denies the capability.
UNDX_BRAIN_WORKSPACE_ENABLED=

# Hard ceiling on entries in one working context, across every slot. The
# twenty-fifth entry is refused rather than displacing the first, because
# the entry most likely to be displaced by a busy retrieval is the
# constraint the person stated at the start.
# Default '24'; a bound or label, with no authorisation content.
UNDX_WORKSPACE_MAX_ITEMS=

# Character budget for everything held in one working context. Counted
# rather than estimated, for the same reason the retrieval budget is.
# Default '8000'; a bound or label, with no authorisation content.
UNDX_WORKSPACE_MAX_CHARS=

# How long a working context stays usable. Past it the context is abandoned,
# not resumed: what it observed about the account is no longer evidence of
# anything current, and a stale observation is how UNDX describes a state
# that has since changed.
# Default '300'; a bound or label, with no authorisation content.
UNDX_WORKSPACE_TTL_SECONDS=

# Allow salience routing to decide which parts of the product a request is
# about. Off means every focus is empty and each call site selects context
# the way it does today, which is the current behaviour.
# Default '0'; absence denies the capability.
UNDX_BRAIN_ATTENTION_ENABLED=

# How many product areas one request may activate. Configuration may lower
# this and may not raise it: a mistyped value must be able to narrow
# attention, never turn the router into a system that opens everything.
# Default '6'; a bound or label, with no authorisation content.
UNDX_ATTENTION_MAX_AREAS=

# How many capabilities one request may carry forward, out of the eighty
# registered. Additionally clamped to the working context's skill-slot
# ceiling, so attention can never offer the workspace more than it will
# accept.
# Default '6'; a bound or label, with no authorisation content.
UNDX_ATTENTION_MAX_CAPABILITIES=

# Allow goal understanding to say that a request names no operation. Off
# means every goal reads as unknown and each call site takes the intent
# matcher's best capability as the goal, which is the current behaviour and
# the one that lets "fix my alert" become a write.
# Default '0'; absence denies the capability.
UNDX_BRAIN_GOALS_ENABLED=

# Maximum steps in one plan. A plan that wants more is refused, not
# truncated: a truncated plan is a plan that stops halfway through a multi-
# write goal.
# Default '6'; a bound or label, with no authorisation content.
UNDX_PLANNER_MAX_STEPS=

# Maximum governed tool calls across one plan, counting retries.
# Default '8'; a bound or label, with no authorisation content.
UNDX_PLANNER_MAX_TOOL_CALLS=

# Retries per step. Writes are never retried by the planner regardless of
# this value — idempotency is enforced at the gateway, and a planner that
# retries a write is a planner that duplicates one.
# Default '1'; a bound or label, with no authorisation content.
UNDX_PLANNER_MAX_RETRIES=

# Wall-clock bound on one plan, after which it expires rather than resuming.
# Default '120'; a bound or label, with no authorisation content.
UNDX_PLANNER_TASK_TIMEOUT_SECONDS=

# Validate that the rendered response claims nothing the evidence does not
# support. Fail-closed: an unparseable value leaves the check on.
# Default '1'; absence denies the capability.
UNDX_RESPONSE_FACTUALITY_CHECK=

# How many drafts rejected by the factuality check may be discarded and re-
# rendered before UNDX stops searching and answers with the honest boundary
# instead. The default sits above the whole search space, so this ceiling
# only ever narrows; lowering it makes UNDX give up sooner and say less. It
# was declared 1/max 3 while the loop could build forty-four drafts, and
# read by nothing, so every value it could hold described behaviour the
# system did not have.
# Default '64'; a bound or label, with no authorisation content.
UNDX_RESPONSE_MAX_REGENERATIONS=

# When a memory class cannot establish its owner scope, refuse to read or
# write it. This is the flag that stops one account's memory reaching
# another's response when a lookup degrades.
# Default '1'; absence denies the capability. Declared required: running on
# the default is a misconfiguration worth reporting, not a working state.
UNDX_MEMORY_FAIL_CLOSED=

# Allow long-term persistence of user-approved preferences.
# Default '0'; absence denies the capability.
UNDX_MEMORY_USER_PREFERENCES_ENABLED=

# Allow stored facts to age and to be compared across time. Off means a
# remembered claim is returned with the same weight on the day it was
# recorded and six weeks later, and a new observation that disagrees with a
# stored one lands beside it unremarked — which is the current behaviour. On
# means a fact past its trust level's horizon may only be cited "as of" when
# it was observed, and a disagreement is reported rather than silently
# overwritten or silently kept.
# Default '0'; absence denies the capability.
UNDX_BRAIN_FACTS_ENABLED=

# Allow the accumulated learning-event log to be read as evidence rather
# than counted. Off means ``pulse_ai_learning_events`` keeps being written
# by eleven call sites and read by one ``SELECT COUNT(*)``, which is the
# current behaviour. On means an owner's own events can be loaded through
# the memory scope and asked questions a count cannot answer — which
# capability fails most, whether one kind of event tends to follow another —
# with every answer carrying how many events it rests on and refusing to
# generalise below a floor.
# Default '0'; absence denies the capability.
UNDX_BRAIN_LEARNING_ENABLED=

# Allow a write to be described before it happens, and the description to be
# checked afterwards. Off means ``simulate_operation`` keeps returning one
# of two constant strings chosen by whether the caller passed a failure,
# which is the current behaviour: it reads no resource and answers
# identically for a capability that can be undone and one that cannot. On
# means a proposed call is read against the capability registry's undo
# graph, so the answer states what the verifier should read back afterwards,
# whether the call can be reversed at all, whether reversal needs an id that
# will not exist until the write verifies, and which prior values will be
# destroyed unless they are read first — and the prediction can then be
# compared against what actually happened, which is the part that makes it a
# prediction rather than a description.
# Default '0'; absence denies the capability.
UNDX_BRAIN_PREDICTION_ENABLED=

# Allow more than one candidate operation to be held at once, and compared.
# Off means ``match_capability`` keeps returning a single best-scoring
# capability and discarding the rest, which is the current behaviour: a
# runner-up one point behind is indistinguishable at the call site from no
# runner-up at all. On means the same scoring is kept as a ranked list,
# candidates within a near-tie of the leader are named, and a contested band
# is separated on declared data — a read is preferred to a write, a
# reversible write to an irreversible one, a narrower blast radius to a
# wider one. Two contested writes that none of those rules separate are
# returned undecided rather than guessed between. The ranking is the
# matcher's own and not a second opinion: a test holds the top of the list
# against ``match_capability`` over every registered phrasing.
# Default '0'; absence denies the capability.
UNDX_BRAIN_SELECTION_ENABLED=

# Allow a plan to run as more than one step, spending against the ceilings
# ``UNDX_PLANNER_MAX_TOOL_CALLS``, ``UNDX_PLANNER_MAX_RETRIES`` and
# ``UNDX_PLANNER_TASK_TIMEOUT_SECONDS``. Off means those three numbers are
# declared and unread, which is the current behaviour: ``bounds.Ledger``
# enforces them and nothing runs a plan through it, because execution is one
# step per request. On means a plan is admitted against the step ceiling
# first and then walked step by step through a ledger that spends and never
# refunds — a call is spent per attempt so retries cannot buy their way past
# the tool-call budget, a write is never retried because a timeout does not
# say whether the first attempt landed, and expiry stops the run rather than
# resuming it. The executor performs nothing itself; it calls back into
# whatever the caller supplies, so it cannot become a second path to the
# gateway. A run that stops part-way reports ``ok=False`` and names the
# writes that already landed and the ones whose outcome is unknown, because
# half of a multi-write goal is a state nobody asked for and reporting it as
# success is the failure this whole layer exists to prevent.
# Default '0'; absence denies the capability.
UNDX_BRAIN_EXECUTOR_ENABLED=

# Allow the Brain to observe whether its own past answers were judged right,
# by joining ``agent_action`` and ``message_answered`` to
# ``feedback_recorded`` on the ``message_id`` all three carry. Off means
# nothing spans turns: uncertainty can be reported within one response and
# no pattern in the mistakes is ever noticed, which is the current
# behaviour. On means a correctness rate is computed per account and per
# capability, reported as a Wilson interval rather than a bare percentage
# and never below twelve judged answers, with the unjudged count stated
# beside it because voluntary feedback is heavily selection-biased and
# silence is not approval. Requires UNDX_BRAIN_LEARNING_ENABLED in practice,
# since the window it reads comes from ``learning.load``. The result is
# reported and never acted on: nothing here reaches ``selection``, because a
# capability that is often corrected has not been shown to have caused the
# correction, and down-ranking it on that evidence would be a causal claim
# made where nobody would see it.
# Default '0'; absence denies the capability.
UNDX_BRAIN_CALIBRATION_ENABLED=

# Allow the Brain to seal untrusted text into one uniform envelope before it
# reaches a prompt, instead of each source being fenced by whatever module
# happens to handle it. Off means today's arrangement: native context is
# key-allowlisted and clamped but unfenced, corpus excerpts get their own
# fence, the user turn is classified by ``pulse_ai_safety``, and live web
# search results get no fence at all while being rendered into the system
# message under the heading ``Approved PulseSoc knowledge``. On means every
# source is wrapped the same way, with a declaration naming its provenance
# and denying it authority placed before it and a reassertion placed after
# it, so a payload never has the last word. Breakout does not depend on the
# payload's cooperation: reserved tags inside it are escaped before
# rendering, so the closing fence appears exactly once whatever the payload
# contains. This flag gates the envelope *discipline*; it does not gate the
# escaping, which ``corpus.prompt_block`` applies unconditionally because it
# closes a confirmed breakout and changes nothing for any payload that was
# not attempting one. The envelope stops text escaping its position and does
# not stop it arguing from inside — persuasion within the fence remains a
# model-behaviour problem and is not claimed here.
# Default '0'; absence denies the capability.
UNDX_BRAIN_ENVELOPE_ENABLED=

# Restrict the Brain path to the QA cohort. On by default so that enabling
# the Brain in production does not, by itself, expose it to anybody.
# Default '1'; absence denies the capability.
UNDX_BRAIN_QA_ONLY=

# Percentage of non-QA users eligible for the Brain read path. Ignored
# entirely while UNDX_BRAIN_QA_ONLY is on.
# Default '0'; absence denies the capability.
UNDX_BRAIN_ROLLOUT_PERCENT=

# Percentage eligible for Brain-planned writes. Kept separate from the read
# rollout because a read that is wrong is a bad answer and a write that is
# wrong is a changed account.
# Default '0'; absence denies the capability.
UNDX_BRAIN_WRITES_ROLLOUT_PERCENT=

# Emit Brain stage counters and durations to the existing log stream.
# Default '1'; absence degrades the feature but the request survives.
UNDX_BRAIN_METRICS_ENABLED=

# Record when a knowledge source, tool, or provider answered in a degraded
# state, so a response built on partial evidence can say so.
# Default '1'; absence degrades the feature but the request survives.
UNDX_DEGRADATION_TRACKING_ENABLED=
