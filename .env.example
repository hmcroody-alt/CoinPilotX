# --- CJ supplier integration (sandbox only) ------------------------------------
# Master gate for the CJ dropshipping supplier surface. Truthy values are
# 1/true/on/yes (case-insensitive); unset or anything else is OFF, which is the
# default. While OFF the supplier routes answer 404 and the connection layer
# raises 503 "disabled" — a fresh deployment therefore looks like the feature
# does not exist rather than like it is switched off.
BUSINESS_OS_SUPPLIERS_CJ=
# Which CJ environment the fulfillment path is allowed to talk to. SANDBOX is
# the only accepted value and is the default when unset. Any other value does
# NOT unlock production: it makes every supplier intent refuse with
# production_fulfillment_disabled / production_fulfillment_locked (409).
CJ_ENVIRONMENT_MODE=SANDBOX
# Kill switch that stays OFF. Default "false"; only false/0/off/blank read as
# OFF. Setting it to anything else does not enable production fulfillment — it
# hard-refuses all supplier fulfillment instead. Real supplier funding is
# refused unconditionally in code regardless of this variable.
PRODUCTION_CJ_FULFILLMENT_ENABLED=false
# Identifier for the fixed egress/IP pool used to pace CJ API calls. Must match
# [A-Za-z0-9_.:-]{1,100}. Default is blank, and blank means every quota
# admission raises 503 EGRESS_CONFIGURATION_REQUIRED, so CJ calls never leave
# the process. Every worker sharing an egress IP must use the same value AND
# the same database; a group admits at most 3 supplier accounts.
CJ_EGRESS_GROUP=
# Operator attestation that the outbound IP behind CJ_EGRESS_GROUP has actually
# been verified. OFF by default, and while OFF hosted multi-merchant CJ reports
# BLOCKED_BY_EGRESS_ARCHITECTURE — single-merchant is unaffected, since one
# account cannot breach a three-account ceiling however the addresses fall.
# It is an assertion, not evidence: on Railway the backend and the supplier
# worker were measured egressing from two different addresses under one label
# (docs/cj/CJ_EGRESS_ARCHITECTURE.md). Do not set this to unblock scale testing;
# the quota counter would then be enforcing CJ's per-IP limit against a label
# that does not correspond to an IP.
CJ_EGRESS_IP_ATTESTED=
# The two network gates, both OFF by default and both required before any
# request reaches CJ (503 provider_approval_required / provider_network_disabled
# while unset). _APPROVED records that CJ has actually approved hosted custody
# of delegated credentials and a fixed egress/account plan — it is an assertion
# by the operator, not evidence, so do not set it to unblock a test.
CJ_HOSTED_CREDENTIALS_APPROVED=
CJ_NETWORK_ENABLED=
# Scheduler gate for supplier_worker.py. OFF by default; every tick returns
# {"status": "disabled"} and no outbox row is ever retried or reconciled, which
# looks identical to an idle queue.
CJ_RECONCILIATION_ENABLED=
# Adds our own raise site to supplier error payloads as `origin` (file:line),
# plus the endpoint and provider code when the rejection came from a provider
# call, and which half of the CSRF gate refused. OFF by default. Every value it
# emits is a constant of our source or a field SupplierError validates itself —
# never provider response data, never caller input — so it is safe to turn on
# against a live store, but it is still internal structure on the wire and
# belongs off unless something is actively being diagnosed.
CJ_SUPPLIER_DIAGNOSTIC_ORIGIN=
# Supplier credential vault (AES-256-GCM, its own key namespace — it never falls
# back to the private office / session / signing keys). Provision through
# service-scoped secrets, NOT as shared plain Railway variables, and never store
# a merchant's CJ key here: this holds the ring, not the credentials.
# Comma-separated key_id:material pairs. key_id matches [a-z0-9][a-z0-9_.-]{0,31};
# material is a 32-byte key, hex or base64. Blank or malformed = every supplier
# credential read/write fails 503 credential_vault_unavailable. Keep retired
# keys in the ring until re-encryption is proven.
SUPPLIER_CREDENTIAL_KEYS=
# Which key_id in the ring encrypts new writes. Defaults to the first ring entry;
# a value that is not in the ring makes the whole vault unavailable.
SUPPLIER_CREDENTIAL_KEY_ACTIVE=
# Separate, STABLE 32-byte key (hex or base64) for account fingerprints. It is
# deliberately independent of the rotating ciphertext ring: rotating it
# re-derives every fingerprint and orphans existing ownership and quota rows,
# so it needs an explicit migration, never a casual rotation. Blank = 503.
SUPPLIER_ACCOUNT_INDEX_KEY=

# --- CJ isolated staging runtime (cj_staging_runtime.py) -----------------------
# These belong to the fenced Railway staging service and are never set by the
# production Procfile. `guard()` asserts every one of them on boot and refuses
# to start if any disagrees, so a staging harness cannot be pointed at
# production by accident.
#
# Three of them are asserted NEGATIVELY — the boot guard requires them to be
# absent or off. They are documented here so an operator knows not to set them,
# which is the opposite of the usual reason a variable appears in this file.
#
# Must equal the staging environment id the runtime is fenced to; any other
# value aborts boot. Paired with RAILWAY_PROJECT_ID, documented above.
RAILWAY_ENVIRONMENT_ID=
# Explicit opt-in that this process is the staging acceptance runner. Must be
# exactly "1"; anything else aborts boot.
CJ_STAGING_ACCEPTANCE=
# Provenance only — recorded on the worker heartbeat and returned by health().
# Defaults to "unknown", which is a legible answer rather than a failure.
CJ_DEPLOYED_SHA=
# ASSERTED ABSENT. A merchant's CJ key is per-merchant and belongs in the
# credential vault; a shared environment variable would make one tenant's key
# every tenant's key. Boot fails if this is set to anything at all.
CJ_API_KEY=
# ASSERTED OFF. Real supplier funding is refused unconditionally in code; this
# is the second, explicit lock. Boot fails if it reads truthy.
REAL_CJ_FUNDING_ENABLED=
# ASSERTED OFF. Staging must not mutate subscription state. Boot fails truthy.
CJ_SUBSCRIPTION_MUTATIONS_ENABLED=

# --- Founder allocation policy -------------------------------------------------
# Founder membership is sold as a founding cohort at a locked lifetime price, but
# allocation was governed only by `MAX(founder_number) + 1`. Sequential numbering
# guarantees uniqueness, NOT scarcity — so the cohort was effectively unlimited.
# These two variables make the policy explicit. Both unset = open and uncapped,
# which is the historic behaviour (so leaving them blank changes nothing).
# Maximum number of founder memberships that may ever be issued. Blank/0 =
# uncapped. Counts numbers ISSUED, including revoked ones, because a number is
# never reused — an active-only count would let churn grow the cohort past its cap.
PULSE_FOUNDER_ALLOCATION_LIMIT=
# Set to 1 to stop issuing NEW founder memberships immediately. Existing founders
# are unaffected and can always be re-granted (reactivation, replayed webhook,
# admin repair) — closing the cohort must never strip a member who already holds
# a number.
PULSE_FOUNDER_ALLOCATION_CLOSED=

# --- Sentinel kill switches ----------------------------------------------------
# Precedence: emergency > master > per-domain > per-runbook. High-risk automation
# needs four explicit opt-ins and can be revoked at any layer instantly.
# Set to 1 to kill ALL Sentinel activity, including read-only ingest. No exceptions.
SENTINEL_EMERGENCY_KILL_SWITCH=
# Master gate for every Sentinel AUTOMATION action. DEFAULT OFF: if unset, no
# automation runs at all, so a runbook enabled below still will not fire.
SENTINEL_AUTOMATION_ENABLED=
# Master gate for financial DETECTION (read-only analysis, no state mutation).
# DEFAULT OFF: if unset, financial fraud signals are not evaluated.
SENTINEL_FINANCIAL_DETECTION_ENABLED=
# Observation/ingest. DEFAULT ON when unset, because observation is how Sentinel
# maintains evidence and it never mutates state. Set to 0 to silence intake —
# note that doing so blinds every detection that depends on it.
SENTINEL_INGEST_ENABLED=

# --- Sentinel server defense mesh ----------------------------------------------
# All four are subordinate to SENTINEL_EMERGENCY_KILL_SWITCH above: when that is
# set, every switch here reads as off regardless of its own value.
#
# Creates the Sentinel security schema during boot. DEFAULT ON when unset — this
# only creates storage, it does not enable any control that reads it. Set to 0 to
# refuse; bootstrap runs every boot, so clearing the switch and restarting
# recreates the schema. Nothing is stranded by refusing.
SENTINEL_SCHEMA_BOOTSTRAP_ENABLED=
# Buffered request-path bridge that feeds request metadata to Sentinel.
# DEFAULT OFF: only an explicit truthy value turns it on. Storage existing is a
# separate decision from filling it.
SENTINEL_REQUEST_BRIDGE_ENABLED=
# Cross-worker rate limiting: off | shadow | enforce. DEFAULT off.
# Per-worker counters mean real clients have been getting the configured limit
# multiplied by the worker count, so `enforce` is an immediate tightening against
# a shipped client that cannot be updated. `shadow` counts and reports what
# enforcement would have done without altering a single response — measure with
# shadow before imposing enforce.
SENTINEL_DISTRIBUTED_LIMITS_MODE=
# Enforce participation on the /seen receipt route, so a departed member is
# refused. DEFAULT OFF: the route behaves as it does today and emits an event
# recording the refusal it did not make, so the blast radius is measurable from
# production traffic first.
SENTINEL_RECEIPT_PARTICIPATION_ENFORCED=

# --- Sentinel external intelligence (all provider calls default OFF) ---------
# Master gate for bounded, read-only external intelligence. Leave unset until
# the provider-specific scope and credentials have been verified in production.
SENTINEL_EXTERNAL_INTEL_ENABLED=
# Public CISA Known Exploited Vulnerabilities feed; override only for an
# approved HTTPS mirror. Unset uses CISA's official public feed.
CISA_KEV_FEED_URL=
# Exact repository scope for read-only GitHub security alerts (owner/repository).
# Leave empty until the GitHub provider and its least-privilege credential are ready.
# The SENTINEL_ prefix is load-bearing, not tidiness: GitHub Actions sets a bare
# GITHUB_REPOSITORY on every workflow step, so the unprefixed name cannot be used
# for a value that must be explicitly configured or absent.
SENTINEL_GITHUB_REPOSITORY=
# Optional NVD quota credential. Leave empty for rate-limited keyless access.
NVD_API_KEY=
# GitHub App installation token is preferred. Use only one of these two values;
# neither is public and both must remain empty in this example file.
SENTINEL_GITHUB_APP_TOKEN=
SENTINEL_GITHUB_FINE_GRAINED_TOKEN=

