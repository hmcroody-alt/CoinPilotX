# PulseSoc / CoinPlotXAI Inc. environment template
# Copy to .env for local development only. Never commit real credentials.

# Core app
DATABASE_URL=
# REQUIRED in any deployed environment. Signs Flask sessions and the mobile
# bearer tokens. Boot fails without it, on purpose: each gunicorn worker would
# otherwise invent its own key and reject tokens minted by the other worker.
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=
SECRET_KEY=
SESSION_SECRET=
# Set to 1 to accept a per-process random secret in a deployed environment.
# This re-enables intermittent cross-worker auth failure; only for debugging.
PULSESOC_ALLOW_EPHEMERAL_SECRET=
SESSION_COOKIE_SECURE=1

# Telegram
BOT_TOKEN=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
APP_BASE_URL=https://coinpilotx.app
# Direct/public Stripe links are intentionally not used for Pro checkout.
STRIPE_PRO_LINK=

# Media / video delivery
MEDIA_STORAGE_PROVIDER=r2
R2_PUBLIC_BASE_URL=https://cdn.coinpilotx.app
# Public, no-challenge source URL used only for Mux asset downloads.
# Example: https://pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev
MUX_SOURCE_BASE_URL=
R2_MUX_SOURCE_BASE_URL=

# BTC payments
BTC_PAYMENT_ADDRESS=

# Admin
ADMIN_ANALYTICS_PASSWORD=
ADMIN_DASHBOARD_TOKEN=
ADMIN_BOOTSTRAP_TOKEN=
