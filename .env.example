# AI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
CLAUDE_AI_API=
Gemini_AI_API=
DEEPSEEK_AI_API=
GROQ_AI_API=
# Perplexity embeddings. Read only by services/undx_embedding_service.py, for UNDX
# semantic retrieval. Leaving this unset is a supported production state: retrieval
# falls back to the existing lexical path and UNDX keeps working.
PERPLEXITY_API_KEY=
UNDX_ROUTER_ENABLED=false
UNDX_MULTI_MODEL_MODE=false
UNDX_DEFAULT_AI_PROVIDER=openai
# Self-hosted UNDX candidate (migration Stage 0+). Off by default; external providers unaffected.
# Only routable when ENABLED=true AND BASE_URL is set. Sorts last unless named in PULSE_AI_PROVIDER_ORDER.
UNDX_CANDIDATE_ENABLED=false
UNDX_CANDIDATE_BASE_URL=
UNDX_CANDIDATE_API_KEY=
UNDX_CANDIDATE_MODEL=undx-core-v1

# Market data
# Setting COINGECKO_API_KEY switches the client to the paid "pro" host and the
# x-cg-pro-api-key header; leaving it empty uses the public demo host and
# x-cg-demo-api-key. The demo host rejects paid keys (error 10010), so the host
# and header are always chosen together rather than configured separately.
COINGECKO_API_KEY=
# Override the API host explicitly. Leave empty to derive it from the key as
# described above; set it only to pin a host or point at a mock in testing.
COINGECKO_API_BASE=
# Per-request HTTP timeout in seconds. Default: 8
COINGECKO_TIMEOUT=
# Client-side request budget per minute, kept under the plan's ceiling.
# Default: 270
COINGECKO_RATE_LIMIT_PER_MIN=
# Oldest cached quote still served, in seconds, when CoinGecko is unreachable.
# Default: 1800
COINGECKO_STALE_MAX=
# TTL in seconds for the /simple/price cache. Default: 45
COINGECKO_SIMPLE_PRICE_TTL=
# Furthest back a history query may reach, in days. Default: 730
COINGECKO_HISTORY_MAX_DAYS=

# Market data - monthly credit budget guard
# The per-minute rate limit alone cannot protect a monthly credit allowance:
# the Basic plan permits 300 req/min but only 100,000 credits/month, which is a
# sustained 2.31 req/min. The guard tracks month-to-date spend and widens cache
# TTLs as the budget is consumed, so the plan degrades freshness instead of
# going dark mid-month. It fails open on an unknown spend figure.
# Set to 0/false/no to disable the guard entirely. Default: 1 (enabled)
COINGECKO_BUDGET_GUARD=
# Total credits the plan allows per month. Default: 100000
COINGECKO_MONTHLY_CREDIT=
# Month-end spend the guard steers toward, leaving headroom. Default: 80000
COINGECKO_BUDGET_TARGET=
# Credits consumed before the state becomes "warning". Default: 50000
COINGECKO_BUDGET_WARN=
# Credits consumed before the state becomes "high". Default: 75000
COINGECKO_BUDGET_HIGH=
# Credits consumed before the state becomes "protective". Default: 90000
COINGECKO_BUDGET_PROTECT=
# TTL multiplier applied in the "high" state. Default: 2
COINGECKO_HIGH_TTL_MULTIPLIER=
# TTL multiplier applied in the "protective" state. Default: 4
COINGECKO_PROTECTIVE_TTL_MULTIPLIER=
# How often, in seconds, the guard re-reads month-to-date spend while in the
# "normal" state. Default: 1800
COINGECKO_BUDGET_REFRESH=

COINMARKETCAP_API_KEY=
CMC_API_KEY=

# Sports data
THE_ODDS_API_KEY=
SPORTSDATA_API_KEY=

