# --- Other -----------------------------------------------------------------
AGGREGATE_ANALYTICS_RETENTION_DAYS=730
AI_STORY_IMAGE_ENDPOINT=
AI_STORY_PROVIDER=local_draft
AI_STORY_VIDEO_ENDPOINT=
ALERT_DEFAULT_COOLDOWN_SECONDS=900
# Repeat policy for an alert that is already past its threshold. "progress"
# re-notifies as the price moves further into the breached region; "once" keeps
# the strict single-shot edge trigger.
ALERT_DEFAULT_REPEAT_MODE=progress
# Optional noise floor: how much further the price must move, as a percentage of
# the value the user was last notified about, before a repeat is sent. 0 (the
# default) repeats on every strictly-further value. Duplicate protection does not
# depend on this — re-observing an already-notified price stays silent at any
# setting — so raise it only to make alerts deliberately less chatty.
ALERT_DEFAULT_REPEAT_STEP_PERCENT=0
# Optional floor between two repeat notifications on one alert, in seconds. 0
# (the default) leaves ALERT_WORKER_INTERVAL_SECONDS as the natural rate limit.
# Distinct from ALERT_DEFAULT_COOLDOWN_SECONDS, which rate limits threshold
# *crossings*, not repeats.
# How many holdings one whole-portfolio alert may watch. Same ceiling and same
# reasoning as ALERT_WATCHLIST_MAX_SYMBOLS below, kept separate because the two
# are sized by different things: a watchlist is as long as somebody chose to
# make it, a portfolio is as long as their holdings happen to be. An oversized
# portfolio is refused at creation; one that grows past this *after* the rule
# exists is reported as truncated at evaluation, because a portfolio changes on
# a screen the alert has nothing to do with.
ALERT_PORTFOLIO_MAX_SYMBOLS=25
ALERT_REPEAT_MIN_SECONDS=0
# How many assets one whole-watchlist alert may watch. Not a performance guess:
# each asset costs three small UPDATEs a cycle and the quotes come from one
# cached board, so the real limit is how many simultaneous notifications a
# person can read. A longer list is refused at creation, not silently trimmed —
# so lowering this stops new oversized rules but leaves existing ones running.
ALERT_WATCHLIST_MAX_SYMBOLS=25
ALERT_WORKER_BATCH_LIMIT=500
ALERT_WORKER_INTERVAL_SECONDS=45
ALERT_WORKER_STALE_SECONDS=180
