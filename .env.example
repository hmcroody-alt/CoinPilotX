# --- Media upload limits and pipeline ------------------------------------------
COMM_V2_AUDIO_MAX_MB=25
COMM_V2_FILE_MAX_MB=1024
COMM_V2_IMAGE_MAX_MB=100
COMM_V2_MAX_ATTACHMENTS=8
COMM_V2_VIDEO_MAX_MB=1024
COMM_V2_VOICE_MAX_MB=100
COMM_V2_VOICE_MAX_SECONDS=300
# Deliverable file types sellers may attach to digital marketplace listings,
# and the per-file size cap for those uploads (buyer downloads are gated on a
# paid order). Read by services/marketplace_listing_types.py.
MARKETPLACE_DIGITAL_ALLOWED_TYPES=pdf,zip,xlsx,xls,csv,txt,md,doc,docx,ppt,pptx,key,epub,mobi,json,mp3,wav,m4a,aac,ogg,mp4,mov,webm,png,jpg,jpeg,gif,webp,psd,ai,sketch,fig
MARKETPLACE_DIGITAL_MAX_MB=200
MEDIA_COVER_FFMPEG_TIMEOUT_SECONDS=45
# Frames darker than this average luma are rejected as cover candidates, so the
# picker keeps seeking instead of shipping a black opening frame as the poster.
MEDIA_COVER_MIN_LUMA=18
MEDIA_DIRECT_UPLOAD_MAX_VIDEO_GB=25
MEDIA_REQUIRE_DURABLE_UPLOAD=
MEDIA_UPLOAD_ALLOWED_TYPES=jpg,jpeg,png,webp,gif,mp4,webm,mov,mp3,m4a,aac,wav,ogg,pdf,txt,doc,docx
MEDIA_UPLOAD_DIR=static/uploads
MEDIA_UPLOAD_MAX_AUDIO_MB=15
MEDIA_UPLOAD_MAX_FILE_MB=12
MEDIA_UPLOAD_MAX_GIF_MB=8
MEDIA_UPLOAD_MAX_IMAGE_MB=12
MEDIA_UPLOAD_MAX_VIDEO_MB=150
# Sustainable 720p bitrate used to derive the direct-to-storage byte ceiling from
# each surface's duration ceiling. Lowering it makes long videos fail on size
# while the duration policy still claims to allow them.
MEDIA_UPLOAD_VIDEO_BUDGET_MBPS=3.2
# The sweep that retires rows still promising media the bucket no longer holds.
# Nothing else revisits an upload once it goes ready, so batch 0 means a row
# whose object was deleted keeps claiming it forever and the client draws an
# empty player. RECHECK_HOURS is how long a row is trusted between probes;
# lowering it buys freshness at the cost of a HEAD per row per pass.
MEDIA_WORKER_AVAILABILITY_RECHECK_HOURS=24
MEDIA_WORKER_AVAILABILITY_RECONCILE_BATCH=10
MEDIA_WORKER_BATCH_SIZE=25
MEDIA_WORKER_COVER_BACKLOG_BATCH=4
MEDIA_WORKER_COVER_SYNC_BATCH=25
# The reconciler that measures duration for assets no webhook ever reported.
# Batch 0 disables it, and the measured-duration ceiling then depends entirely on
# the webhook arriving. MAX_AGE_DAYS bounds how far back it looks.
MEDIA_WORKER_DURATION_RECONCILE_BATCH=25
MEDIA_WORKER_DURATION_RECONCILE_MAX_AGE_DAYS=7
MEDIA_WORKER_FFMPEG_CRF=23
MEDIA_WORKER_FFMPEG_PRESET=veryfast
MEDIA_WORKER_INTERVAL_SECONDS=20
MEDIA_WORKER_MAX_ATTEMPTS=3
# How many stranded messenger attachments one worker cycle re-queues. These are
# attachments whose derived assets — a photo thumbnail, a video's metadata, a
# voice waveform — were never produced, so the message sits in the thread with
# no preview. 0 stops the sweep, and nothing else re-queues that work: the
# previews stay missing until someone notices. The per-attachment half of the
# ceiling is MESSENGER_MEDIA_MAX_PROCESSING_ROUNDS below.
MEDIA_WORKER_MESSENGER_RECONCILE_BATCH=50
MEDIA_WORKER_PLAYBACK_BACKLOG_BATCH=2
# Ceiling on the ffprobe call that reads a source's audio streams before a
# transcode. It runs per backlog row, so an unreachable source stalls the whole
# cycle for this long rather than failing the one row.
MEDIA_WORKER_PROBE_TIMEOUT_SECONDS=30
MEDIA_WORKER_REPLAY_WAIT_MAX_AGE_HOURS=72
MEDIA_WORKER_TRANSCODE_TIMEOUT_SECONDS=180

# --- Stored-video duration ceilings -------------------------------------------
# Per-surface overrides for services/stored_video_policy.py. Empty means the
# code default (5400s = 90 minutes for messenger/post/reel, 60s for status).
# An override may only *tighten* a surface; a larger value is ignored, so these
# cannot be used to raise the platform ceiling without a deploy.
MESSENGER_VIDEO_MAX_SECONDS=
POST_VIDEO_MAX_SECONDS=
REEL_VIDEO_MAX_SECONDS=
STATUS_VIDEO_MAX_SECONDS=

MESSENGER_MEDIA_LOCAL_DIR=
# How many job rows one attachment may accumulate before the sweep above gives
# up on it and stops re-queueing. This is the stop, not a tuning knob: an
# attachment whose bytes are genuinely gone would otherwise be retried on every
# cycle for the life of the product. Raising it buys more attempts at flaky
# work and costs a longer tail of doomed retries. Floored at 1 in code.
MESSENGER_MEDIA_MAX_PROCESSING_ROUNDS=4
MESSENGER_MEDIA_MAX_REQUEST_MB=
# Per-media-type upload ceilings, in megabytes. Unset falls back to the code
# defaults (photo 15, video 2048, voice 25, file 50). MESSENGER_FILE_MAX_MB now
# governs document attachments — PDF, Word, Excel, PowerPoint, text and CSV —
# which the shared server-side allowlist accepts as media_type "file" and which
# are always served as downloads, never rendered inline.
# MESSENGER_MEDIA_MAX_REQUEST_MB is derived from the largest of these when unset,
# and is only honoured when it caps the route *below* that; it cannot raise it.
MESSENGER_PHOTO_MAX_MB=15
# 2048 MB is ~3.1 Mbps across the 90-minute duration ceiling. Lowering this
# below what 90 minutes costs makes the duration policy unreachable.
MESSENGER_VIDEO_MAX_MB=2048
MESSENGER_VOICE_MAX_MB=25
MESSENGER_FILE_MAX_MB=50

